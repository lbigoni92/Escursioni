    private static readonly string[] _groupReadOnly = ["wikiloc_id", "sha256_payload"];

    protected override void OnInitialized() => LoadFile();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !string.IsNullOrEmpty(_gpxUrl))
        {
            await JS.InvokeVoidAsync("initGpxMap", "gpx-map", _gpxUrl);
        }
    }

    private void LoadFile()
    {
        _message = "";
        var decoded = Uri.UnescapeDataString(FileName);
        var migrations = Parser.ListMigrations();
        var match = migrations.FirstOrDefault(m => m.FileName == decoded);
        if (match != null)
        {
            _mf = Parser.Parse(match.FullPath);
            _title = _mf.HikeValues.GetValueOrDefault("titolo") ?? decoded;
            UpdatePreview();
            var wid = _mf.HikeValues.GetValueOrDefault("wikiloc_id");
            _gpxUrl = !string.IsNullOrEmpty(wid) ? $"/gpx/{wid}.gpx" : null;
            _descrizioneText = _mf.HikeValues.GetValueOrDefault("descrizione") ?? "";
        }

        // Compute prev/next navigation
        var idx = migrations.FindIndex(m => m.FileName == decoded);
        _prevFile = idx > 0 ? migrations[idx - 1].FileName : null;
        _nextFile = idx >= 0 && idx < migrations.Count - 1 ? migrations[idx + 1].FileName : null;
    }

    private void Reload() { LoadFile(); StateHasChanged(); }
    private string GetVal(string col) => _mf?.HikeValues.GetValueOrDefault(col) ?? "";

    private void SetValue(string col, string? val)
    {
        if (_mf == null) return;
        _mf.HikeValues[col] = string.IsNullOrWhiteSpace(val) ? null : val;
        UpdatePreview();
    }

    private void UpdatePreview()
    {
        if (_mf == null) return;
        try
        {
            _preview = Parser.GenerateJson(_mf);
        }
        catch (FormatException ex)
        {
            _preview = "⚠ " + ex.Message;
        }
    }

    private void Save()
    {
        if (_mf == null) return;
        try
        {
            Parser.Save(_mf);
            _message = $"Salvato alle {DateTime.Now:HH:mm:ss}";
        }
        catch (FormatException ex)
        {
            _message = $"Non salvato: {ex.Message}";
        }
        UpdatePreview();
    }

    private void SetAsCover(int photoIndex)
    {
        if (_mf == null) return;

        var photo = _mf.MediaRows[photoIndex];

        // Reset all existing cover rows to 'foto'
        foreach (var row in _mf.MediaRows)
        {
            if (string.Equals(row.GetValueOrDefault("tipo"), "cover", StringComparison.OrdinalIgnoreCase))
                row["tipo"] = "foto";
        }

        // Set the selected photo as cover
        photo["tipo"] = "cover";

        UpdatePreview();
        var photoFileName = Path.GetFileName(photo.GetValueOrDefault("path_relativo") ?? "");
        _message = $"Cover impostata: {photoFileName}";
    }

    private HikeSeoContext BuildSeoContext() => new(
        Comune: GetVal("comune"),
        Provincia: GetVal("provincia"),
        Regione: GetVal("regione"),
        Difficolta: GetVal("difficolta"),
        DistanzaKm: GetVal("distanza_km"),
        DislivelloM: GetVal("dislivello_m"),
        TipoGiro: GetVal("tipo_giro")
    );

    private async Task GenerateSeoTitle()
    {
        if (_mf == null) return;
        _seoTitleLoading = true;
        _seoTitleError = null;
        StateHasChanged();
        try
        {
            var titolo = GetVal("titolo");
            var descrizione = GetVal("descrizione");
            if (string.IsNullOrWhiteSpace(titolo) && string.IsNullOrWhiteSpace(descrizione))
            {
                _seoTitleError = "Compila titolo o descrizione prima di generare.";
                return;
            }
            var result = await MetaGen.GenerateSeoTitleAsync(titolo, descrizione, BuildSeoContext());
            SetValue("titolo_seo", result);
        }
        catch (Exception ex)
        {
            _seoTitleError = $"Errore: {ex.Message}";
        }
        finally
        {
            _seoTitleLoading = false;
            StateHasChanged();
        }
    }

