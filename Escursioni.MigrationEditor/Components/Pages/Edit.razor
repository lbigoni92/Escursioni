    private static readonly string[] _groupGeneral = ["titolo", "attivita", "regione", "provincia", "comune", "url"];
    private static readonly string[] _groupTechnical = ["distanza_km", "dislivello_m", "quota_min_m", "quota_max_m",
        "tempo_min", "tempo_hhmm", "tempo_mov_min", "tempo_mov_hhmm", "coordinate_count",
        "difficolta", "tipo_giro", "superficie"];
    private static readonly string[] _groupDates = ["data_escursione", "data_registrato", "data_caricato", "data_pubblicazione"];
