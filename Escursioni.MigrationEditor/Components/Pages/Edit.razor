    private void RecalculateFromGpx()
    {
        if (_mf == null) return;
        _gpxStatsLoading = true;
        _gpxStatsMessage = null;
        _gpxStatsError = null;
        StateHasChanged();
        try
        {
            var widStr = GetVal("wikiloc_id");
            if (!int.TryParse(widStr, out var wid) || wid <= 0)
            {
                _gpxStatsError = "wikiloc_id mancante.";
                return;
            }

            var stats = GpxStats.Calculate(wid);
            if (stats == null)
            {
                _gpxStatsError = $"GPX non trovato per wikiloc_id {wid}.";
                return;
            }

            var updated = new List<string>();

            if (TryUpdateField("distanza_km", stats.DistanzaKm, v => v.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)))
                updated.Add("distanza");
            if (TryUpdateField("dislivello_m", stats.DislivelloM, v => ((int)v).ToString()))
                updated.Add("dislivello");
            if (TryUpdateField("quota_min_m", stats.QuotaMinM, v => ((int)v).ToString()))
                updated.Add("quota_min");
            if (TryUpdateField("quota_max_m", stats.QuotaMaxM, v => ((int)v).ToString()))
                updated.Add("quota_max");
            if (TryUpdateField("tempo_min", stats.TempoMin, v => ((int)v).ToString()))
            {
                updated.Add("tempo");
                SetValue("tempo_hhmm", stats.TempoHhmm);
            }
            if (TryUpdateField("tempo_mov_min", stats.TempoMovMin, v => ((int)v).ToString()))
            {
                updated.Add("tempo_mov");
                SetValue("tempo_mov_hhmm", stats.TempoMovHhmm);
            }

            _gpxStatsMessage = updated.Count > 0
                ? $"Aggiornati: {string.Join(", ", updated)}"
                : "Tutti i valori entro il 20%, nessuna modifica.";
        }
        catch (Exception ex)
        {
            _gpxStatsError = $"Errore: {ex.Message}";
        }
        finally
        {
            _gpxStatsLoading = false;
            StateHasChanged();
        }
    }

    private bool TryUpdateField(string field, double calculated, Func<double, string> format)
    {
        var currentStr = GetVal(field);
        var current = 0.0;
        if (!string.IsNullOrWhiteSpace(currentStr))
            double.TryParse(currentStr, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out current);

        if (!GpxStatsService.DiffersSignificantly(current, calculated))
            return false;

        SetValue(field, format(calculated));
        return true;
    }

    private async Task ToggleDictation()
    {
        _dictationError = null;
        if (_isDictating)
        {
            await JS.InvokeVoidAsync("stopDictation");
            _isDictating = false;
        }
        else
        {
            _dotNetRef ??= DotNetObjectReference.Create(this);
            _isDictating = true;
            await JS.InvokeVoidAsync("startDictation", _dotNetRef);
        }
    }

    [JSInvokable]
    public void OnDictationResult(string text)
    {
        if (_mf == null) return;
        var separator = string.IsNullOrEmpty(_descrizioneText) ? "" : " ";
        _descrizioneText += separator + text;
        SetValue("descrizione", _descrizioneText);
        InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public void OnDictationError(string error)
    {
        _dictationError = error;
        InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public void OnDictationStopped()
    {
        _isDictating = false;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        _dotNetRef?.Dispose();
    }
}
