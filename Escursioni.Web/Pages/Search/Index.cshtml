@page "/ricerca"
@model Escursioni.Web.Pages.Search.IndexModel

@inject IConfiguration Configuration
@{
    var baseUrl = (Configuration["Site:BaseUrl"] ?? "https://escursionilucabigoni.it").TrimEnd('/');
    ViewData["Title"] = "Ricerca escursioni – Escursioni Luca Bigoni";
    ViewData["MetaDescription"] = "Cerca escursioni in Toscana per località o testo: trova tracce GPS, foto, descrizioni e itinerari ideali per escursioni, trekking e passeggiate.";
    ViewData["CanonicalUrl"] = baseUrl + "/ricerca";
    ViewData["OgImage"] = baseUrl + "/images/og-home.jpg";
    ViewData["Breadcrumbs"] = new List<(string Label, string Url)> { ("Ricerca", "") };
}

<section>
    <header class="page-header">
        <h1 class="page-title">Cerca un'escursione</h1>
        <p class="page-subtitle">
            Scrivi una cima, un lago o una parola, oppure scegli una località per vedere le escursioni nei dintorni. I risultati si aggiornano mentre scrivi.
            Preferisci sfogliare? Guarda le <a href="/escursioni" title="Escursioni per zona">escursioni per zona</a> o la <a href="/mappa" title="Mappa escursioni">mappa</a>.
        </p>
    </header>

    <form method="get" id="search-form" class="search-box" role="search">
        @* Un solo campo: si scrive un posto, una cima o una parola; i suggerimenti propongono località ed escursioni *@
        <div class="search-field">
            <label for="q" class="visually-hidden">Cerca un'escursione</label>
            <svg class="search-field-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M11 4a7 7 0 1 0 0 14 7 7 0 0 0 0-14zM20 20l-4-4" /></svg>
            <input id="q" name="Q" type="search" class="input-text search-input"
                   placeholder="Cima, lago o località"
                   autocomplete="off" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="search-suggestions" />
            <button class="btn search-submit" type="submit">Cerca</button>
            <ul id="search-suggestions" class="autocomplete-list search-suggestions" role="listbox" hidden></ul>
        </div>

        <div class="search-place-row">
            <span class="place-chip" id="place-chip" hidden>
                <span>Vicino a <strong id="place-chip-name"></strong></span>
                <button type="button" id="place-chip-remove" aria-label="Togli la località">×</button>
            </span>
            <label class="search-radius">
                <span>entro</span>
                <select id="raggio" name="RaggioKm" class="input-select">
                    <option value="10">10 km</option>
                    <option value="20" selected>20 km</option>
                    <option value="30">30 km</option>
                    <option value="50">50 km</option>
                    <option value="100">100 km</option>
                </select>
            </label>
            <button type="button" class="btn-secondary search-geo" id="use-position" hidden>Vicino a me</button>
        </div>

        <input type="hidden" id="comune" name="Comune" />
        <input type="hidden" id="lat" name="Lat" />
        <input type="hidden" id="lon" name="Lon" />
        <input type="hidden" id="page-number" name="PageNumber" value="1" />

        <div class="hike-filters search-filters">
            <fieldset class="filter-group">
                <legend>Difficoltà</legend>
                <label><input type="radio" name="Difficolta" value="" checked /> Tutte</label>
                @foreach (var d in Model.DifficoltaDisponibili)
                {
                    <label><input type="radio" name="Difficolta" value="@d" /> @d</label>
                }
            </fieldset>
            <div class="filter-group filter-sort">
                <label for="ordina">Ordina</label>
                <select id="ordina" name="OrdinaPer">
                    <option value="data_desc" selected>Più recenti (o più vicine)</option>
                    <option value="distanza_asc">Più corte</option>
                    <option value="distanza_desc">Più lunghe</option>
                    <option value="dislivello_asc">Meno dislivello</option>
                    <option value="dislivello_desc">Più dislivello</option>
                    <option value="nome_asc">Nome (A → Z)</option>
                    <option value="data_asc">Più vecchie</option>
                </select>
            </div>
        </div>
    </form>

    <p class="search-summary" id="search-summary" aria-live="polite"></p>

    <div class="card-grid" id="search-results"></div>

    <nav class="pagination" id="search-pagination" hidden></nav>

    <noscript>
        <p class="search-summary">La ricerca richiede JavaScript. Puoi sfogliare le <a href="/escursioni" title="Escursioni per zona">escursioni per zona</a> o la <a href="/mappa" title="Mappa escursioni">mappa</a>.</p>
    </noscript>

</section>

@section Scripts {
<script src="~/js/search.js" asp-append-version="true" defer></script>
}
