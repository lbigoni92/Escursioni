@page "/contatti"
@model Escursioni.Web.Pages.ContactModel

<section>
    <h1 class="page-title">Contatti</h1>
    <p class="page-subtitle">
        Se vuoi scrivermi per domande sulle escursioni, suggerimenti o collaborazioni.
    </p>

 
    <form method="post" class="contact-form" autocomplete="off">
        <div class="form-field">
            <label for="Name">Nome</label>
            <input asp-for="Form.Name" class="input-text" placeholder="Il tuo nome" />
            <span asp-validation-for="Form.Name" class="field-validation-error"></span>
        </div>
        <div class="form-field">
            <label for="Email">Email</label>
            <input asp-for="Form.Email" class="input-text" placeholder="La tua email" />
            <span asp-validation-for="Form.Email" class="field-validation-error"></span>
        </div>
        <div class="form-field">
            <label for="Message">Messaggio</label>
            <textarea asp-for="Form.Message" class="input-text" rows="5" placeholder="Scrivi qui il tuo messaggio..."></textarea>
            <span asp-validation-for="Form.Message" class="field-validation-error"></span>
        </div>
        <div class="form-field form-field--checkbox">
            <input asp-for="Form.PrivacyConsent" type="checkbox" id="privacyconsent" required />
            <label for="privacyconsent">Ho letto e accetto la <a href="/privacy" target="_blank">privacy policy</a></label>
            <span asp-validation-for="Form.PrivacyConsent" class="field-validation-error"></span>
        </div>
        <div class="form-field form-field--buttons">
            <button class="btn" type="submit">Invia messaggio</button>
        </div>
        @if (Model.SuccessMessage != null)
        {
            <div class="form-success">@Model.SuccessMessage</div>
        }
        @if (Model.ErrorMessage != null)
        {
            <div class="form-error">@Model.ErrorMessage</div>
        }
    </form>

    <div class="privacy-info">
        <small>
            I dati inviati saranno utilizzati solo per rispondere alla tua richiesta, secondo la normativa privacy (GDPR). Per dettagli consulta la <a href="/privacy">pagina Privacy</a>.
        </small>
    </div>

    <partial name="Shared/_ValidationScriptsPartial" />
</section>
