@page "/contatti"
@model Escursioni.Web.Pages.ContactModel

<section>
    <header class="page-header">
        <h1 class="page-title">Contatti</h1>
        <p class="page-subtitle">
            Scrivimi per domande sulle escursioni, consigli sui sentieri, segnalazioni o collaborazioni.
        </p>
    </header>

    <div class="contact-card">
        <p>Il modo più semplice per contattarmi è scrivermi un'email:</p>
        <p><a class="btn" href="mailto:@Model.ContactEmail" title="Scrivi una email a Luca Bigoni">@Model.ContactEmail</a></p>
        <p class="contact-note">Se segnali un problema su un sentiero, indica il nome dell'escursione o il link alla sua pagina.</p>
    </div>

    <div class="privacy-info">
        <small>
            I dati che mi invii via email saranno utilizzati solo per rispondere alla tua richiesta, secondo la normativa privacy (GDPR). Per dettagli consulta la <a href="/privacy" title="Pagina Privacy">pagina Privacy</a>.
        </small>
    </div>
</section>
