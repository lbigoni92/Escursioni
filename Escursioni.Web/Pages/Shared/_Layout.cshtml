<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]@(ViewData["Title"]?.ToString()?.Contains("Escursioni") == true ? "" : " | Escursioni")</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="msvalidate.01" content="2F3FB46C5CFC143B9FCA6B962AEF2FB5" />
    @if (ViewData["MetaDescription"] is string md && !string.IsNullOrWhiteSpace(md))
    {
        <meta name="description" content="@md" />
    }
    <meta name="robots" content="@(ViewData["RobotsDirective"] is string robotsDir && !string.IsNullOrWhiteSpace(robotsDir) ? robotsDir : "index, follow")" />
    @inject IConfiguration Configuration
    @{
        var baseUrl = (Configuration["Site:BaseUrl"] ?? "https://www.escursionilucabigoni.it").TrimEnd('/');
        var reqPath = Context.Request.Path.HasValue ? Context.Request.Path.Value : "/";
        if (string.IsNullOrEmpty(reqPath)) reqPath = "/";
        // ensure path starts with '/'
        if (!reqPath.StartsWith('/')) reqPath = "/" + reqPath;
        var computedCanonical = (ViewData["CanonicalUrl"] as string);
        if (string.IsNullOrWhiteSpace(computedCanonical)) {
            computedCanonical = baseUrl + (reqPath == "/" ? "/" : reqPath.TrimEnd('/'));
        }
        var computedOgImage = (ViewData["OgImage"] as string);
        if (string.IsNullOrWhiteSpace(computedOgImage)) {
            computedOgImage = baseUrl + "/images/og-home.jpg";
        }
    }
    <link rel="canonical" href="@computedCanonical" />
    <link rel="alternate" hreflang="it" href="@computedCanonical" />
    <link rel="alternate" hreflang="x-default" href="@computedCanonical" />

    <!-- Open Graph -->
    <meta property="og:type" content="@(ViewData["OgType"] ?? "website")" />
    <meta property="og:title" content="@(ViewData["Title"] ?? "Escursioni")" />
    @if (ViewData["MetaDescription"] is string ogDesc && !string.IsNullOrWhiteSpace(ogDesc))
    {
        <meta property="og:description" content="@ogDesc" />
    }
    <meta property="og:image" content="@computedOgImage" />
    <meta property="og:url" content="@computedCanonical" />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:site_name" content="Escursioni Luca Bigoni – Trekking in Toscana" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@(ViewData["Title"] ?? "Escursioni")" />
    @if (ViewData["MetaDescription"] is string twDesc && !string.IsNullOrWhiteSpace(twDesc))
    {
        <meta name="twitter:description" content="@twDesc" />
    }
    <meta name="twitter:image" content="@computedOgImage" />

    <link rel="icon" type="image/png" href="~/favicon-48.png" sizes="48x48" />
    <link rel="icon" type="image/png" href="~/favicon-192.png" sizes="192x192" />
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="~/favicon-192.png" />
    <link rel="manifest" href="~/manifest.json" />
    <link rel="preconnect" href="https://unpkg.com" crossorigin />
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin />
    <link rel="dns-prefetch" href="https://unpkg.com" />
    <link rel="dns-prefetch" href="https://cdnjs.cloudflare.com" />
    <script>
        // Applica subito il tema light-mode se salvato in localStorage
        (function() {
            try {
                if (localStorage.getItem('theme') === 'light') {
                    document.documentElement.classList.add('light-mode');
                    document.body.classList.add('light-mode');
                }
            } catch (e) {}
        })();
    </script>
    <link rel="stylesheet" href="~/css/site.css" />
    @RenderSection("Head", required: false)
</head>
<body>
    <a href="#main-content" class="skip-link" title="Vai al contenuto principale">Vai al contenuto principale</a>

    <header class="top-bar">
        <div class="top-bar-inner">
            <a class="brand" asp-page="/Index" title="Escursioni Luca Bigoni – Home">Escursioni Luca Bigoni</a>
            <button class="hamburger" id="hamburger-btn" aria-label="Apri menu" aria-expanded="false">
                <span></span><span></span><span></span>
            </button>
            <nav class="main-nav" id="main-nav" aria-label="Navigazione principale">
                <a asp-page="/Index" title="Home">Home</a>
                <a asp-page="/Escursioni/Index" title="Escursioni per zona">Escursioni</a>
                <a asp-page="/Map/Index" title="Mappa escursioni">Mappa</a>
                <a asp-page="/Search/Index" title="Ricerca escursioni">Ricerca</a>
                <a asp-page="/About" title="Chi sono – Luca Bigoni">Chi sono</a>
                <a asp-page="/Contact" title="Contatti">Contatti</a>
                <button id="toggle-darkmode" style="margin-left:1.2rem;padding:0.3rem 0.8rem;border-radius:999px;border:1px solid #4b5563;background:var(--bg);color:var(--text-main);cursor:pointer;">🌓</button>
            </nav>
        </div>
    </header>

    <div class="breadcrumb" aria-label="Breadcrumb">
        @if (ViewData["Breadcrumbs"] is List<(string Label, string Url)> crumbs && crumbs.Count > 0)
        {
            <nav aria-label="Breadcrumb">
                <ol style="list-style:none;display:flex;flex-wrap:wrap;gap:0.3rem;padding:0;margin:0;font-size:0.85rem;">
                    <li><a href="/" title="Home">Home</a></li>
                    @foreach (var (label, url) in crumbs)
                    {
                        <li style="display:flex;align-items:center;"><span style="margin:0 0.3rem;">›</span>
                            @if (!string.IsNullOrEmpty(url))
                            {
                                <a href="@url" title="@label">@label</a>
                            }
                            else
                            {
                                <span>@label</span>
                            }
                        </li>
                    }
                </ol>
            </nav>
        }
    </div>


    <main id="main-content" class="page-container @(ViewData["FullWidth"] is true ? "page-container--full" : "")" role="main">
        @RenderBody()
    </main>

    <footer class="footer">
        <div class="footer-inner">
            <div class="footer-copyright">© @DateTime.Now.Year - Escursioni Luca Bigoni | Trekking in Toscana</div>
            <div class="footer-sep">·</div>
            <div class="footer-rss"><a href="/feed/rss" title="Feed RSS">Feed RSS</a></div>
            <div class="footer-sep">·</div>
            <div class="footer-privacy"><a href="/privacy" title="Privacy policy">Privacy</a></div>
            <div class="footer-sep">·</div>
            <div class="footer-social">
                <a href="https://www.linkedin.com/in/luca-bigoni/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" title="LinkedIn">in</a>
                <a href="https://www.instagram.com/lbigoni/" target="_blank" rel="noopener noreferrer" aria-label="Instagram" title="Instagram">ig</a>
                <a href="https://www.facebook.com/luca.bigoni1/" target="_blank" rel="noopener noreferrer" aria-label="Facebook" title="Facebook">fb</a>
            </div>
        </div>
    </footer>


    @RenderSection("Scripts", required: false)

    <!-- JSON-LD Structured Data -->
   <script type="application/ld+json">
{"@@context":"https://schema.org","@@type":"WebSite","name":"Escursioni Luca Bigoni - Trekking e sentieri in Toscana","url":"https://www.escursionilucabigoni.it/","potentialAction":{"@@type":"SearchAction","target":"https://www.escursionilucabigoni.it/ricerca?Q={search_term_string}","query-input":"required name=search_term_string"}}
</script>

<script type="application/ld+json">
{"@@context":"https://schema.org","@@type":"Person","name":"Luca Bigoni","url":"https://www.escursionilucabigoni.it/","jobTitle":"Escursionista amatoriale","knowsAbout":["Escursioni in Toscana","Trekking Alpi Apuane","Sentieri Garfagnana"],"address":{"@@type":"PostalAddress","addressRegion":"Toscana","addressCountry":"IT"},"sameAs":["https://www.linkedin.com/in/luca-bigoni/","https://www.instagram.com/lbigoni/","https://www.facebook.com/luca.bigoni1/"]}
</script>
    @if (ViewData["JsonLd"] is string jsonLd && !string.IsNullOrWhiteSpace(jsonLd))
    {
        <script type="application/ld+json">@Html.Raw(jsonLd)</script>
    }
    @if (ViewData["JsonLd2"] is string jsonLd2 && !string.IsNullOrWhiteSpace(jsonLd2))
    {
        <script type="application/ld+json">@Html.Raw(jsonLd2)</script>
    }
    @if (ViewData["BreadcrumbJsonLd"] is string breadcrumbLd && !string.IsNullOrWhiteSpace(breadcrumbLd))
    {
        <script type="application/ld+json">@Html.Raw(breadcrumbLd)</script>
    }

    <script>
        // Dark mode toggle + Hamburger menu — non-blocking
        requestAnimationFrame(function() {
            var btn = document.getElementById('toggle-darkmode');
            if (btn) {
                btn.addEventListener('click', function() {
                    document.body.classList.toggle('light-mode');
                    document.documentElement.classList.toggle('light-mode');
                    localStorage.setItem('theme', document.body.classList.contains('light-mode') ? 'light' : 'dark');
                });
            }
            var hamburger = document.getElementById('hamburger-btn');
            var mainNav = document.getElementById('main-nav');
            if (hamburger && mainNav) {
                hamburger.addEventListener('click', function() {
                    var open = !mainNav.classList.contains('is-open');
                    mainNav.classList.toggle('is-open');
                    hamburger.classList.toggle('is-open');
                    hamburger.setAttribute('aria-expanded', open);
                });
            }
        });
    </script>
</body>
</html>
