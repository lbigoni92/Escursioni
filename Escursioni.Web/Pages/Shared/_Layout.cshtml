@inject IConfiguration Configuration
@inject IHikeRepository Repo
@inject PlaceRepository Places
@{
    // Dichiarate fuori da <head>/<body>: i tag helper ne fanno degli scope separati
    var baseUrl = (Configuration["Site:BaseUrl"] ?? "https://escursionilucabigoni.it").TrimEnd('/');
    var reqPath = Context.Request.Path.HasValue ? Context.Request.Path.Value : "/";
    if (string.IsNullOrEmpty(reqPath)) reqPath = "/";
    // ensure path starts with '/'
    if (!reqPath.StartsWith('/')) reqPath = "/" + reqPath;
    var computedCanonical = (ViewData["CanonicalUrl"] as string);
    if (string.IsNullOrWhiteSpace(computedCanonical)) {
        computedCanonical = baseUrl + (reqPath == "/" ? "/" : reqPath.TrimEnd('/'));
    }
    var computedOgImage = (ViewData["OgImage"] as string);
    if (string.IsNullOrWhiteSpace(computedOgImage)) {
        computedOgImage = baseUrl + "/images/og-home.jpg";
    }

    var zones = await Repo.GetTagSummaryAsync();
    var currentZone = ViewData["CurrentZone"] as string;
    var crumbs = ViewData["Breadcrumbs"] as List<(string Label, string Url)>;

    // Voce di menu attiva: /escursioni copre anche zone e schede escursione
    string? Current(string href) =>
        (href == "/" ? reqPath == "/" : href == "/escursioni" ? reqPath.StartsWith("/escursioni") : reqPath.TrimEnd('/') == href)
            ? "page" : null;

    // Icone (24x24, solo tratto): un solo path per icona
    var navItems = new (string Href, string Label, string Title, string Icon)[]
    {
        ("/", "Home", "Escursioni in Toscana – Home", "M3 10.5 12 3l9 7.5V21h-6v-6H9v6H3z"),
        ("/escursioni", "Escursioni per zona", "Tutte le escursioni divise per zona", "M2 20 9 7l4.5 7.5L16 11l6 9z"),
        ("/mappa", "Mappa", "Mappa interattiva delle escursioni con tracce GPS", "M9 4 3 6v14l6-2 6 2 6-2V4l-6 2-6-2zM9 4v14M15 6v14"),
        ("/ricerca", "Ricerca", "Cerca escursioni per località o parola chiave", "M11 4a7 7 0 1 0 0 14 7 7 0 0 0 0-14zM20 20l-4-4"),
        ("/chi-sono", "Chi sono", "Chi è Luca Bigoni", "M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM4 21a8 8 0 0 1 16 0"),
        ("/contatti", "Contatti", "Scrivi a Luca Bigoni", "M3 5h18v14H3zM3 6l9 7 9-7"),
    };
}
<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]@(ViewData["Title"]?.ToString()?.Contains("Escursioni") == true ? "" : " | Escursioni")</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="msvalidate.01" content="2F3FB46C5CFC143B9FCA6B962AEF2FB5" />
    @if (ViewData["MetaDescription"] is string md && !string.IsNullOrWhiteSpace(md))
    {
        <meta name="description" content="@md" />
    }
    <meta name="robots" content="@(ViewData["RobotsDirective"] is string robotsDir && !string.IsNullOrWhiteSpace(robotsDir) ? robotsDir : "index, follow")" />
    <meta name="author" content="Luca Bigoni" />
    <meta name="theme-color" content="#0f1a15" />
    <link rel="canonical" href="@computedCanonical" />
    <link rel="alternate" hreflang="it" href="@computedCanonical" />
    <link rel="alternate" hreflang="x-default" href="@computedCanonical" />
    <link rel="alternate" type="application/rss+xml" title="Escursioni Luca Bigoni – Feed RSS" href="/feed/rss" />

    <!-- Open Graph -->
    <meta property="og:type" content="@(ViewData["OgType"] ?? "website")" />
    <meta property="og:title" content="@(ViewData["Title"] ?? "Escursioni")" />
    @if (ViewData["MetaDescription"] is string ogDesc && !string.IsNullOrWhiteSpace(ogDesc))
    {
        <meta property="og:description" content="@ogDesc" />
    }
    <meta property="og:image" content="@computedOgImage" />
    <meta property="og:url" content="@computedCanonical" />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:site_name" content="Escursioni Luca Bigoni – Trekking in Toscana" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@(ViewData["Title"] ?? "Escursioni")" />
    @if (ViewData["MetaDescription"] is string twDesc && !string.IsNullOrWhiteSpace(twDesc))
    {
        <meta name="twitter:description" content="@twDesc" />
    }
    <meta name="twitter:image" content="@computedOgImage" />

    <link rel="icon" type="image/png" href="~/favicon-48.png" sizes="48x48" />
    <link rel="icon" type="image/png" href="~/favicon-192.png" sizes="192x192" />
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="~/favicon-192.png" />
    <link rel="manifest" href="~/manifest.json" />
    <script>
        // Applica subito il tema light-mode se salvato in localStorage
        (function() {
            // Con JavaScript attivo: i controlli che ne hanno bisogno (filtri) si mostrano subito, senza spostare la pagina
            document.documentElement.classList.add('js');
            try {
                // Qui il <body> non esiste ancora: la classe gli viene copiata subito dopo l'apertura
                if (localStorage.getItem('theme') === 'light') {
                    document.documentElement.classList.add('light-mode');
                }
            } catch (e) {}
        })();
    </script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @RenderSection("Head", required: false)
</head>
<body>
    <script>if (document.documentElement.classList.contains('light-mode')) document.body.classList.add('light-mode');</script>
    <a href="#main-content" class="skip-link">Vai al contenuto principale</a>

    <header class="mobile-bar">
        <a class="brand" href="/" title="Escursioni Luca Bigoni – Home">
            <svg class="brand-logo" viewBox="0 0 32 32" aria-hidden="true"><circle cx="23" cy="9" r="4" class="brand-sun" /><path d="M2 27 12 11l6 9 3-4 9 11z" class="brand-mountain" /></svg>
            <span class="brand-text">Escursioni <strong>Luca Bigoni</strong></span>
        </a>
        <button class="hamburger" id="hamburger-btn" type="button" aria-label="Apri menu" aria-expanded="false" aria-controls="sidebar">
            <span></span><span></span><span></span>
        </button>
    </header>

    <aside class="sidebar" id="sidebar" aria-label="Menu del sito">
        <a class="brand sidebar-brand" href="/" title="Escursioni Luca Bigoni – Home">
            <svg class="brand-logo" viewBox="0 0 32 32" aria-hidden="true"><circle cx="23" cy="9" r="4" class="brand-sun" /><path d="M2 27 12 11l6 9 3-4 9 11z" class="brand-mountain" /></svg>
            <span class="brand-text">Escursioni <strong>Luca Bigoni</strong><small>Trekking in Toscana</small></span>
        </a>

        <nav class="main-nav" id="main-nav" aria-label="Navigazione principale">
            <ul class="nav-list">
                @foreach (var item in navItems)
                {
                    <li>
                        <a class="nav-link" href="@item.Href" title="@item.Title" aria-current="@Current(item.Href)">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="@item.Icon" /></svg>
                            <span>@item.Label</span>
                        </a>
                    </li>
                }
            </ul>
        </nav>

        @if (Places.All.Count > 0)
        {
            <nav class="zone-nav" aria-label="Luoghi raggiunti">
                <p class="nav-heading">Luoghi raggiunti</p>
                <ul class="nav-list">
                    @foreach (var type in Escursioni.Web.Models.PlaceType.All)
                    {
                        <li>
                            <a class="zone-link" href="/@type.Slug" title="@type.Titolo raggiunti dalle mie escursioni" aria-current="@Current("/" + type.Slug)">
                                <span>@type.Titolo</span><span class="zone-count">@Places.OfType(type).Count</span>
                            </a>
                        </li>
                    }
                </ul>
            </nav>
        }

        @if (zones.Count > 0)
        {
            <nav class="zone-nav" aria-label="Escursioni per zona">
                <p class="nav-heading">Zone</p>
                <ul class="nav-list">
                    @foreach (var (tag, count) in zones)
                    {
                        var zoneHref = "/escursioni/zona/" + TagHelper.ToSlug(tag);
                        var isZone = reqPath == zoneHref || string.Equals(currentZone, tag, StringComparison.OrdinalIgnoreCase);
                        <li>
                            <a class="zone-link" href="@zoneHref" title="Escursioni @tag" aria-current="@(isZone ? "page" : null)">
                                <span>@tag</span><span class="zone-count">@count<span class="visually-hidden"> escursioni</span></span>
                            </a>
                        </li>
                    }
                </ul>
            </nav>
        }

        <div class="sidebar-foot">
            <button id="toggle-darkmode" class="theme-toggle" type="button" aria-label="Cambia tema chiaro/scuro">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path class="icon-moon" d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /><path class="icon-sun" d="M12 7a5 5 0 1 0 0 10 5 5 0 0 0 0-10zM12 1v2M12 21v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M1 12h2M21 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4" /></svg>
                <span class="theme-label-dark">Tema chiaro</span><span class="theme-label-light">Tema scuro</span>
            </button>
        </div>
    </aside>
    <div class="sidebar-backdrop" id="sidebar-backdrop" hidden></div>

    <div class="site-content">
        @if (crumbs is { Count: > 0 })
        {
            <nav class="breadcrumb" aria-label="Breadcrumb">
                <ol>
                    <li><a href="/" title="Home">Home</a></li>
                    @foreach (var (label, url) in crumbs)
                    {
                        <li>
                            @if (!string.IsNullOrEmpty(url))
                            {
                                <a href="@url" title="@label">@label</a>
                            }
                            else
                            {
                                <span aria-current="page">@label</span>
                            }
                        </li>
                    }
                </ol>
            </nav>
        }

        <main id="main-content" class="page-container @(ViewData["FullWidth"] is true ? "page-container--full" : "")">
            @RenderBody()
        </main>

        <footer class="footer">
            <div class="footer-grid">
                <section class="footer-about">
                    <a class="brand" href="/" title="Escursioni Luca Bigoni – Home">
                        <svg class="brand-logo" viewBox="0 0 32 32" aria-hidden="true"><circle cx="23" cy="9" r="4" class="brand-sun" /><path d="M2 27 12 11l6 9 3-4 9 11z" class="brand-mountain" /></svg>
                        <span class="brand-text">Escursioni <strong>Luca Bigoni</strong></span>
                    </a>
                    <p>Escursioni e trekking in Toscana raccontati da un escursionista amatoriale: tracce GPS, foto e descrizioni dei sentieri di Alpi Apuane, Garfagnana, Versilia e Appennino.</p>
                    <div class="footer-social">
                        <a href="https://www.linkedin.com/in/luca-bigoni/" target="_blank" rel="noopener noreferrer me" title="Luca Bigoni su LinkedIn">LinkedIn</a>
                        <a href="https://www.instagram.com/lbigoni/" target="_blank" rel="noopener noreferrer me" title="Luca Bigoni su Instagram">Instagram</a>
                        <a href="https://www.facebook.com/luca.bigoni1/" target="_blank" rel="noopener noreferrer me" title="Luca Bigoni su Facebook">Facebook</a>
                    </div>
                </section>
                <nav aria-label="Pagine del sito">
                    <p class="footer-heading">Esplora</p>
                    <ul>
                        @foreach (var item in navItems.Skip(1))
                        {
                            <li><a href="@item.Href" title="@item.Title">@item.Label</a></li>
                        }
                        @foreach (var type in Escursioni.Web.Models.PlaceType.All)
                        {
                            <li><a href="/@type.Slug" title="@type.Titolo raggiunti dalle mie escursioni">@type.Titolo</a></li>
                        }
                    </ul>
                </nav>
                <nav aria-label="Zone più visitate">
                    <p class="footer-heading">Zone principali</p>
                    <ul>
                        @foreach (var (tag, _) in zones.Take(6))
                        {
                            <li><a href="/escursioni/zona/@TagHelper.ToSlug(tag)" title="Escursioni @tag">Escursioni @tag</a></li>
                        }
                    </ul>
                </nav>
                <nav aria-label="Informazioni">
                    <p class="footer-heading">Info</p>
                    <ul>
                        <li><a href="/feed/rss" title="Feed RSS delle ultime escursioni">Feed RSS</a></li>
                        <li><a href="/sitemap.xml" title="Mappa del sito in XML">Sitemap</a></li>
                        <li><a href="/privacy" title="Informativa privacy">Privacy</a></li>
                        <li><a href="/note-legali" title="Note legali e condizioni d'uso">Note legali</a></li>
                    </ul>
                </nav>
            </div>
            <p class="footer-bottom">© @DateTime.Now.Year Escursioni Luca Bigoni · Trekking in Toscana</p>
        </footer>
    </div>

    @RenderSection("Scripts", required: false)

    <!-- JSON-LD Structured Data -->
   <script type="application/ld+json">
{"@@context":"https://schema.org","@@type":"WebSite","name":"Escursioni Luca Bigoni - Trekking e sentieri in Toscana","url":"https://escursionilucabigoni.it/","potentialAction":{"@@type":"SearchAction","target":"https://escursionilucabigoni.it/ricerca?Q={search_term_string}","query-input":"required name=search_term_string"}}
</script>

<script type="application/ld+json">
{"@@context":"https://schema.org","@@type":"Person","@@id":"https://escursionilucabigoni.it/#luca-bigoni","name":"Luca Bigoni","url":"https://escursionilucabigoni.it/chi-sono","jobTitle":"Escursionista amatoriale","knowsAbout":["Escursioni in Toscana","Trekking Alpi Apuane","Sentieri Garfagnana"],"address":{"@@type":"PostalAddress","addressRegion":"Toscana","addressCountry":"IT"},"sameAs":["https://www.linkedin.com/in/luca-bigoni/","https://www.instagram.com/lbigoni/","https://www.facebook.com/luca.bigoni1/"]}
</script>
    @if (ViewData["JsonLd"] is string jsonLd && !string.IsNullOrWhiteSpace(jsonLd))
    {
        <script type="application/ld+json">@Html.Raw(jsonLd)</script>
    }
    @if (ViewData["JsonLd2"] is string jsonLd2 && !string.IsNullOrWhiteSpace(jsonLd2))
    {
        <script type="application/ld+json">@Html.Raw(jsonLd2)</script>
    }
    @{
        // BreadcrumbList generato dalle briciole visibili quando la pagina non ne fornisce uno proprio
        var breadcrumbLd = ViewData["BreadcrumbJsonLd"] as string;
        if (string.IsNullOrWhiteSpace(breadcrumbLd) && crumbs is { Count: > 0 })
        {
            var items = new List<object> { new Dictionary<string, object> { ["@type"] = "ListItem", ["position"] = 1, ["name"] = "Home", ["item"] = baseUrl + "/" } };
            foreach (var (label, url) in crumbs)
            {
                var item = new Dictionary<string, object> { ["@type"] = "ListItem", ["position"] = items.Count + 1, ["name"] = label };
                item["item"] = string.IsNullOrEmpty(url) ? computedCanonical : url.StartsWith('/') ? baseUrl + url : url;
                items.Add(item);
            }
            breadcrumbLd = System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, object>
            {
                ["@context"] = "https://schema.org",
                ["@type"] = "BreadcrumbList",
                ["itemListElement"] = items,
            });
        }
    }
    @if (!string.IsNullOrWhiteSpace(breadcrumbLd))
    {
        <script type="application/ld+json">@Html.Raw(breadcrumbLd)</script>
    }

    <script>
        // Tema chiaro/scuro + menu laterale (drawer su mobile) — non-blocking
        requestAnimationFrame(function() {
            var btn = document.getElementById('toggle-darkmode');
            if (btn) {
                btn.addEventListener('click', function() {
                    document.body.classList.toggle('light-mode');
                    document.documentElement.classList.toggle('light-mode');
                    try { localStorage.setItem('theme', document.body.classList.contains('light-mode') ? 'light' : 'dark'); } catch (e) {}
                });
            }
            var hamburger = document.getElementById('hamburger-btn');
            var sidebar = document.getElementById('sidebar');
            var backdrop = document.getElementById('sidebar-backdrop');
            if (hamburger && sidebar) {
                function setOpen(open) {
                    sidebar.classList.toggle('is-open', open);
                    hamburger.classList.toggle('is-open', open);
                    hamburger.setAttribute('aria-expanded', open);
                    hamburger.setAttribute('aria-label', open ? 'Chiudi menu' : 'Apri menu');
                    document.body.classList.toggle('nav-open', open);
                    if (backdrop) backdrop.hidden = !open;
                }
                hamburger.addEventListener('click', function() { setOpen(!sidebar.classList.contains('is-open')); });
                if (backdrop) backdrop.addEventListener('click', function() { setOpen(false); });
                document.addEventListener('keydown', function(e) {
                    if (e.key === 'Escape' && sidebar.classList.contains('is-open')) { setOpen(false); hamburger.focus(); }
                });
            }
        });
    </script>

    @* Avviso quando manca la connessione: la pagina è la copia salvata dal service worker *@
    <div class="offline-banner" id="offline-banner" role="status" hidden>Sei offline: stai vedendo la copia salvata di questa pagina.</div>
    <script>
        (function () {
            // Schede consultabili anche senza campo (wwwroot/sw.js)
            if ('serviceWorker' in navigator) navigator.serviceWorker.register('/sw.js').catch(function () { });
            var banner = document.getElementById('offline-banner');
            function update() { banner.hidden = navigator.onLine; }
            window.addEventListener('online', update);
            window.addEventListener('offline', update);
            update();
        })();
    </script>

    @* Solo in Production: l'export del deploy gira con --no-launch-profile, quindi in Production *@
    <environment include="Production">
        <!-- Cloudflare Web Analytics --><script type='module' src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "2309a86f1783458fb7988e0b7a4e7353"}'></script><!-- End Cloudflare Web Analytics -->
    </environment>
</body>
</html>
