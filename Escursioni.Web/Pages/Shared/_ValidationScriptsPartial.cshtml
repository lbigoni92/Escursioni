@* Validation scripts for client-side validation (unobtrusive) *@
<environment include="Development">
    <script src="/lib/jquery/jquery.min.js"></script>
    <script src="/lib/jquery-validate/jquery.validate.min.js"></script>
    <script src="/lib/jquery-validate-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</environment>
<environment exclude="Development">
    <script src="/lib/jquery/jquery.min.js" asp-append-version="true"></script>
    <script src="/lib/jquery-validate/jquery.validate.min.js" asp-append-version="true"></script>
    <script src="/lib/jquery-validate-unobtrusive/jquery.validate.unobtrusive.min.js" asp-append-version="true"></script>
</environment>
