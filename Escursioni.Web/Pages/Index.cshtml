@page
@model Escursioni.Web.Pages.IndexModel


<section>
    <h1 class="page-title">Escursioni in Toscana – Trekking, sentieri e tracce GPS</h1>

    <p class="page-subtitle">
        Benvenuto su <strong>escursionilucabigoni.it</strong>! Sono <strong>Luca Bigoni</strong>, escursionista appassionato.
        Qui trovi le mie <strong>escursioni in Toscana</strong>: <strong>trekking sulle Alpi Apuane</strong>,
        sentieri in <strong>Garfagnana</strong>, percorsi vicino a <strong>Lucca</strong> e molto altro.
        Ogni escursione include tracce GPS scaricabili, foto e descrizioni dettagliate.
    </p>
   <div class="about-warning">
        <strong>Tutte le escursioni presenti su questo sito nascono da esperienza diretta sul campo.</strong><br />
        <span>La difficoltà riportata è soggettiva e può variare in base alla preparazione e alle condizioni del momento: <strong>valuta sempre con attenzione e responsabilità ogni uscita</strong>.</span>
    </div>

    <section class="section">
        <h2 style="font-size:1.2rem;margin-bottom:0.5rem;">Ultime escursioni</h2>
        <div class="card-grid">
            @foreach (var h in Model.UltimeEscursioni)
            {
                var cover = Escursioni.Web.Pages.IndexModel.CoverPath(h);
                var coverThumb = ImageHelper.ThumbPath(cover);
                var displayTitle = !string.IsNullOrWhiteSpace(h.TitoloSeo) ? h.TitoloSeo : h.Titolo;
                <article class="hike-card">
                    @if (!string.IsNullOrWhiteSpace(cover))
                    {
                        <a asp-page="/Escursioni/Dettaglio"
                           asp-route-slug="@Escursioni.Web.Pages.Escursioni.IndexModel.MakeSlug(h.Titolo)"
                           title="@displayTitle">
                            <picture>
                                @if (coverThumb != null)
                                {
                                    <source srcset="~/@coverThumb" type="image/webp" />
                                }
                                <img src="~/@cover" alt="@displayTitle" loading="lazy" decoding="async" width="400" height="160" />
                            </picture>
                        </a>
                    }
                    <div class="hike-card-body">
                        <h2 class="hike-card-title">
                            <a asp-page="/Escursioni/Dettaglio"
                               asp-route-slug="@Escursioni.Web.Pages.Escursioni.IndexModel.MakeSlug(h.Titolo)"
                               title="@displayTitle">
                                @displayTitle
                            </a>
                        </h2>
                        <div class="hike-card-meta">
                            @if (!string.IsNullOrWhiteSpace(h.Comune))
                            {
                                @($"{h.Comune}, {h.Provincia}")
                            }
                            else if (!string.IsNullOrWhiteSpace(h.Regione))
                            {
                                @h.Regione
                            }
                            @if (h.DataEscursione.HasValue)
                            {
                                <span> · @h.DataEscursione.Value.ToString("dd/MM/yyyy")</span>
                            }
                        </div>
                        <div class="hike-card-desc">
                            @{
                                var txt = h.Descrizione ?? "";
                                if (txt.Length > 140) txt = txt[..140] + "...";
                            }
                            @txt
                        </div>
                    </div>
                    <div class="hike-card-footer">
                        <span>
                            @if (h.DistanzaKm.HasValue)
                            {
                                <span>@h.DistanzaKm.Value.ToString("0.0") km</span>
                            }
                            @if (h.DislivelloM.HasValue)
                            {
                                <span> · +@h.DislivelloM.Value m</span>
                            }
                        </span>
                        <span>
                            @if (!string.IsNullOrWhiteSpace(h.Difficolta))
                            {
                                <span class="badge ">@h.Difficolta</span>
                            }
                        </span>
                    </div>
                </article>
            }
        </div>
    </section>
</section>
