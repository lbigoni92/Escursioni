@page
@model Escursioni.Web.Pages.IndexModel

@{
    var heroHikes = Model.InEvidenza;
}
<section class="hero @(heroHikes.Count == 3 ? "hero--with-media" : "")" aria-labelledby="home-title">
    <div class="hero-text">
        <span class="eyebrow">Trekking in Toscana e non solo</span>
        <h1 id="home-title">Escursioni in Toscana – Trekking, sentieri e tracce GPS</h1>
        <p>
            Sono <strong>Luca Bigoni</strong>, escursionista appassionato. Qui trovi le mie
            <strong>escursioni in Toscana</strong>: <strong>trekking sulle Alpi Apuane</strong>, sentieri in
            <strong>Garfagnana</strong>, percorsi vicino a <strong>Lucca</strong> e molto altro, ognuno con
            traccia GPS scaricabile, foto e descrizione dettagliata.
        </p>
        <div class="btn-row">
            <a class="btn" href="/escursioni" title="Tutte le escursioni divise per zona">Esplora le zone</a>
            <a class="btn-secondary" href="/mappa" title="Mappa interattiva delle escursioni">Apri la mappa</a>
            <a class="btn-secondary" href="/ricerca" title="Cerca un'escursione per località o parola chiave">Cerca un sentiero</a>
        </div>
        <ul class="hero-stats">
            <li><strong>@Model.TotaleEscursioni</strong> escursioni</li>
            <li><strong>@Model.Zone.Count</strong> zone</li>
            <li><strong>@HikeDisplay.Number(Model.TotaleKm)</strong> km percorsi</li>
            <li title="Circa @(Model.TotaleDislivello / Escursioni.Web.Pages.IndexModel.EverestM) volte l'altezza dell'Everest"><strong>@HikeDisplay.Number(Model.TotaleDislivello)</strong> m di dislivello</li>
        </ul>
    </div>
    @if (heroHikes.Count == 3)
    {
        <ul class="hero-media" aria-label="Escursioni in evidenza">
            @for (var i = 0; i < heroHikes.Count; i++)
            {
                var hh = heroHikes[i];
                var cover = Escursioni.Web.Pages.IndexModel.CoverPath(hh)!;
                // Due misure (400 e 800 px): il browser sceglie quella adatta al riquadro e allo schermo
                var thumb = ImageHelper.ThumbPath(cover);
                var gallery = ImageHelper.GalleryPath(cover);
                var srcset = string.Join(", ", new[] { thumb != null ? $"/{thumb} 400w" : null, gallery != null ? $"/{gallery} 800w" : null }.Where(x => x != null));
                var title = HikeDisplay.Title(hh);
                <li>
                    <a href="/escursioni/@hh.Slug" title="@title">
                        <picture>
                            @if (srcset.Length > 0)
                            {
                                <source srcset="@srcset" sizes="@(i == 0 ? "(min-width: 1200px) 40vw, 30vw" : "(min-width: 1200px) 20vw, 30vw")" type="image/webp" />
                            }
                            <img src="~/@cover" alt="" decoding="async" width="@(i == 0 ? 800 : 400)" height="@(i == 0 ? 600 : 300)" />
                        </picture>
                        <span>@title</span>
                    </a>
                </li>
            }
        </ul>
    }
</section>

<section aria-labelledby="numeri">
    <div class="section-head">
        <h2 id="numeri">I numeri delle mie escursioni</h2>
    </div>
    @if (Model.Luoghi.Count > 0)
    {
        <ul class="place-cards" aria-label="Luoghi raggiunti">
            @foreach (var (type, count, top) in Model.Luoghi)
            {
                <li>
                    <a href="/@type.Slug" title="@type.Titolo raggiunti dalle mie escursioni">
                        <strong class="place-card-count">@count</strong>
                        <span class="place-card-label">@type.Titolo.ToLowerInvariant()</span>
                        <span class="place-card-top">Quota massima: @top.Nome@(top.QuotaM is int q ? $", {HikeDisplay.Meters(q)}" : "")</span>
                        <span class="place-card-go">Vedi l'elenco <span aria-hidden="true">→</span></span>
                    </a>
                </li>
            }
        </ul>
    }
    @* Nascosti per ora: dislivello totale con l'Everest e record personali (IndexModel.Record li calcola ancora)
    <p class="stats-intro">
        <strong>@HikeDisplay.Number(Model.TotaleDislivello) m</strong> di dislivello in salita: circa
        <strong>@(Model.TotaleDislivello / Escursioni.Web.Pages.IndexModel.EverestM) volte l'altezza dell'Everest</strong>.
    </p>
    <ul class="record-grid" aria-label="Record personali">
        @foreach (var (label, value, hike) in Model.Record)
        {
            <li>
                <span class="record-label">@label</span>
                <strong class="record-value">@value</strong>
                <a href="/escursioni/@hike.Slug" title="@HikeDisplay.Title(hike)">@HikeDisplay.Title(hike)</a>
            </li>
        }
    </ul>
    *@
</section>

<section aria-labelledby="ultime">
    <div class="section-head">
        <h2 id="ultime">Ultime escursioni</h2>
        <a class="section-link" href="/ricerca" title="Tutte le escursioni dalla più recente">Vedi tutte →</a>
    </div>
    <div class="card-grid">
        @foreach (var h in Model.UltimeEscursioni)
        {
            <partial name="_HikeCard" model="h" />
        }
    </div>
</section>

<section aria-labelledby="zone">
    <div class="section-head">
        <h2 id="zone">Escursioni per zona</h2>
        <a class="section-link" href="/escursioni" title="Guida alle zone escursionistiche">Guida alle zone →</a>
    </div>
    <div class="zone-grid">
        @foreach (var z in Model.Zone)
        {
            <partial name="_ZoneTile" model="z" />
        }
    </div>
</section>

@if (Model.Vette.Count > 0)
{
    <section aria-labelledby="vette">
        <div class="section-head">
            <h2 id="vette">Le vette più alte</h2>
            <a class="section-link" href="/vette" title="Tutte le vette raggiunte, dalla più alta">Tutte le @Model.Vette.Count vette →</a>
        </div>
        <ol class="peak-list">
            @foreach (var p in Model.Vette.Take(6))
            {
                <partial name="_PlaceItem" model="p" />
            }
        </ol>
    </section>
}

<div class="about-warning">
    <div>
        <strong>Tutte le escursioni presenti su questo sito nascono da esperienza diretta sul campo.</strong><br />
        <span>La difficoltà riportata è soggettiva e può variare in base alla preparazione e alle condizioni del momento: <strong>valuta sempre con attenzione e responsabilità ogni uscita</strong>.</span>
    </div>
</div>
