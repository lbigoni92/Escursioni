@page "/escursioni"
@model Escursioni.Web.Pages.Escursioni.IndexModel

<header class="page-header">
    <span class="eyebrow">@Model.TotalHikes escursioni · @Model.Zones.Count zone</span>
    <h1 class="page-title">Escursioni per zona</h1>
    <p class="page-subtitle">
        Le @Model.TotalHikes escursioni che ho fatto e registrato, divise in @Model.Zones.Count zone: dalle Alpi Apuane
        all'Appennino tosco-emiliano, dalla costa livornese alla Maremma. Ogni scheda ha traccia GPS, foto, dislivello
        e come arrivare al punto di partenza.
    </p>
</header>

<div class="tag-grid">
    @foreach (var z in Model.Zones)
    {
        <section class="tag-card" aria-labelledby="zona-@z.Slug">
            <partial name="_ZoneTile" model="z" view-data="@(new ViewDataDictionary(ViewData) { ["ZoneTileDecorative"] = true })" />
            <div class="tag-card-body">
                <h2 class="tag-card-title" id="zona-@z.Slug"><a href="/escursioni/zona/@z.Slug" title="Tutte le escursioni @z.Tag">Escursioni @z.Tag</a></h2>
                <p class="tag-card-desc">@z.Description</p>
                @if (z.Hikes.Count > 0)
                {
                    <ul class="tag-card-samples" aria-label="Escursioni recenti in @z.Tag">
                        @foreach (var s in z.Hikes.Take(3))
                        {
                            <li>
                                <a href="/escursioni/@s.Slug">@HikeDisplay.Title(s)</a>
                                @if (!string.IsNullOrWhiteSpace(s.Comune)) { <span> — @s.Comune</span> }
                            </li>
                        }
                    </ul>
                }
                <a class="section-link" href="/escursioni/zona/@z.Slug" title="Tutte le escursioni @z.Tag">Tutte le @z.Count escursioni @z.Tag →</a>
            </div>
        </section>
    }
</div>

<section class="prose section" aria-labelledby="guida">
    <h2 id="guida">Escursioni in Toscana: da dove cominciare</h2>
    <p>
        Sono tutte escursioni che ho fatto io, quasi tutte in Toscana. Per difficoltà:
        @string.Join(", ", Model.PerDifficolta.Select(d => $"{d.Count} {d.Difficolta.ToLowerInvariant()}")).
        Il grado è quello che ho dato su Wikiloc: in ogni scheda trovi dislivello, quote e tempo per capire se fa per te.
    </p>
    <h3>Zona per zona</h3>
    <ul>
        @foreach (var z in Model.Zones.Where(z => z.Count >= 10 && z.Tag != "Estero"))
        {
            var top = Escursioni.Web.Pages.Escursioni.IndexModel.Highest(z);
            var easy = Escursioni.Web.Pages.Escursioni.IndexModel.Easy(z);
            <li>
                <a href="/escursioni/zona/@z.Slug" title="Tutte le escursioni @z.Tag"><strong>@z.Tag</strong></a>: @z.Count escursioni.
                @if (top?.QuotaMaxM is int q)
                {
                    <text>La più alta arriva a @HikeDisplay.Meters(q): <a href="/escursioni/@top.Slug">@HikeDisplay.Title(top)</a>.</text>
                }
                @if (easy != null && easy != top)
                {
                    <text> Per iniziare: <a href="/escursioni/@easy.Slug">@HikeDisplay.Title(easy)</a>.</text>
                }
            </li>
        }
    </ul>
    @if (Model.Luoghi.Count > 0)
    {
        <h3>Se cerchi una meta precisa</h3>
        <p>
            Dalle tracce GPS ho ricavato i luoghi raggiunti:
            @for (var i = 0; i < Model.Luoghi.Count; i++)
            {
                var (t, count) = Model.Luoghi[i];
                <a href="/@t.Slug" title="@t.TitoloLink">@count @t.Titolo.ToLowerInvariant()</a>@(i < Model.Luoghi.Count - 2 ? ", " : i == Model.Luoghi.Count - 2 ? " e " : ".")
            }
            @if (Model.LuoghiConPagina.Count > 0)
            {
                <text> Pagine con storia, sentieri e tutte le mie escursioni da lì:</text>
                @for (var i = 0; i < Model.LuoghiConPagina.Count; i++)
                {
                    var p = Model.LuoghiConPagina[i];
                    <a href="@p.Url">@p.Scheda!.Nome</a>@(i < Model.LuoghiConPagina.Count - 1 ? ", " : ".")
                }
            }
        </p>
    }
    <p>
        Se preferisci partire da un posto vicino a te, usa la <a href="/mappa" title="Mappa delle escursioni">mappa delle escursioni</a>
        o la <a href="/ricerca" title="Ricerca escursioni">ricerca per località</a>, che trova le escursioni entro un raggio da un paese.
    </p>
</section>
