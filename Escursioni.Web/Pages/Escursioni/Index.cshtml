@page "/escursioni"
@model Escursioni.Web.Pages.Escursioni.IndexModel
@using Escursioni.Web.Services

<section>
    <h1 class="page-title">Escursioni per zona</h1>
    <p class="page-subtitle">
        <strong>@Model.TotalHikes escursioni</strong> organizzate per area geografica.
        Scegli la zona che ti interessa per scoprire tutti i sentieri, le tracce GPS e le descrizioni dettagliate.
    </p>

    <div class="tag-grid">
        @foreach (var (tag, count) in Model.TagSummary)
        {
            var slug = TagHelper.ToSlug(tag);
            var desc = TagHelper.GetDescription(tag);
            <a href="/escursioni/zona/@slug" class="tag-card" title="Escursioni @tag">
                <h2 class="tag-card-title">@tag</h2>
                <p class="tag-card-desc">@desc</p>
                <span class="tag-card-count">@count escursioni</span>
            </a>
        }
    </div>
</section>
