@page "/escursioni/zona/{slug}"
@model Escursioni.Web.Pages.Escursioni.TagModel

<header class="page-header">
    <a class="eyebrow" href="/escursioni" title="Tutte le zone escursionistiche">Escursioni per zona</a>
    <h1 class="page-title">Escursioni @Model.TagName</h1>
    <p class="page-subtitle">
        @Model.TagDescription
        <strong>@Model.Escursioni.Count escursioni</strong> in questa zona, dalla più recente.
    </p>
</header>

@{ ViewData["CardHeading"] = "h2"; }
<div class="card-grid">
    @foreach (var h in Model.Escursioni)
    {
        <partial name="_HikeCard" model="h" />
    }
</div>

@if (Model.AltreZone.Count > 0)
{
    <section aria-labelledby="altre-zone">
        <div class="section-head">
            <h2 id="altre-zone">Altre zone</h2>
            <a class="section-link" href="/mappa" title="Mappa di tutte le escursioni">Vedi sulla mappa →</a>
        </div>
        <ul class="chip-list">
            @foreach (var (tag, count) in Model.AltreZone)
            {
                <li><a class="chip" href="/escursioni/zona/@Escursioni.Web.Services.TagHelper.ToSlug(tag)" title="Escursioni @tag">Escursioni @tag <small>@count</small></a></li>
            }
        </ul>
    </section>
}
