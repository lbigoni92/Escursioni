@page "/escursioni/zona/{slug}"
@model Escursioni.Web.Pages.Escursioni.TagModel

<header class="page-header">
    <a class="eyebrow" href="/escursioni" title="Tutte le zone escursionistiche">Escursioni per zona</a>
    <h1 class="page-title">Escursioni @Model.TagName</h1>
    <p class="page-subtitle">
        @Model.TagDescription
        <strong>@Model.Escursioni.Count escursioni</strong> in questa zona, dalla più recente.
    </p>
</header>

@if (Model.Guida != null)
{
    <section class="section prose zone-guide">
        @Html.Raw(Model.Guida.TestoHtml)
    </section>
    <h2>Tutte le mie escursioni @Model.TagName</h2>
}

@{ ViewData["CardHeading"] = Model.Guida != null ? "h3" : "h2"; }
@* Filtri rapidi: compaiono solo con JavaScript attivo, senza JS si vede l'elenco completo *@
@if (Model.Escursioni.Count >= 6)
{
<form class="hike-filters zone-filters" id="hike-filters" aria-label="Filtra le escursioni">
    <fieldset class="filter-group">
        <legend>Difficoltà</legend>
        <label><input type="checkbox" name="diff" value="facile" /> Facile</label>
        <label><input type="checkbox" name="diff" value="medio" /> Media</label>
        <label><input type="checkbox" name="diff" value="difficile" /> Difficile</label>
    </fieldset>
    <fieldset class="filter-group">
        <legend>Lunghezza</legend>
        <label><input type="radio" name="len" value="" checked /> Tutte</label>
        <label><input type="radio" name="len" value="0-8" /> Fino a 8 km</label>
        <label><input type="radio" name="len" value="8-15" /> 8–15 km</label>
        <label><input type="radio" name="len" value="15-999" /> Oltre 15 km</label>
    </fieldset>
    <fieldset class="filter-group">
        <legend>Percorso</legend>
        <label><input type="checkbox" name="loop" value="1" /> Solo anelli</label>
    </fieldset>
    <div class="filter-group filter-sort">
        <label for="hike-sort">Ordina</label>
        <select id="hike-sort" name="sort">
            <option value="date">Più recenti</option>
            <option value="km-asc">Più corte</option>
            <option value="km-desc">Più lunghe</option>
            <option value="gain-asc">Meno dislivello</option>
        </select>
    </div>
    <p class="filter-count" id="hike-filter-count" aria-live="polite"></p>
    <button type="reset" class="filter-reset">Azzera filtri</button>
</form>
}
<p class="filter-empty" id="hike-filter-empty" hidden>Nessuna escursione con questi filtri. <button type="button" class="filter-reset" data-filter-reset>Azzera filtri</button></p>
<div class="card-grid" id="hike-grid">
    @foreach (var h in Model.Escursioni)
    {
        <partial name="_HikeCard" model="h" />
    }
</div>

@if (Model.Guida is { Fonti.Count: > 0 })
{
    <section class="section" aria-labelledby="fonti-zona">
        <h2 id="fonti-zona">Fonti</h2>
        <ul class="sources">
            @foreach (var f in Model.Guida.Fonti)
            {
                <li><a href="@f.Url" target="_blank" rel="noopener">@f.Titolo</a></li>
            }
        </ul>
    </section>
}

@if (Model.AltreZone.Count > 0)
{
    <section aria-labelledby="altre-zone">
        <div class="section-head">
            <h2 id="altre-zone">Altre zone</h2>
            <a class="section-link" href="/mappa" title="Mappa di tutte le escursioni">Vedi sulla mappa →</a>
        </div>
        <ul class="chip-list">
            @foreach (var (tag, count) in Model.AltreZone)
            {
                <li><a class="chip" href="/escursioni/zona/@Escursioni.Web.Services.TagHelper.ToSlug(tag)" title="Escursioni @tag">Escursioni @tag <small>@count</small></a></li>
            }
        </ul>
    </section>
}

@section Scripts {
    <script src="~/js/zone-filters.js" asp-append-version="true" defer></script>
}
