@page "/escursioni/{slug}"
@model Escursioni.Web.Pages.Escursioni.DettaglioModel

@{
    // OnGet risponde 404 se l'escursione non esiste: qui Hike è sempre valorizzato
    var h = Model.Hike!;
    var displayTitle = HikeDisplay.Title(h);
    var location = HikeDisplay.Location(h);
    var zoneSlug = Model.Zone != null ? TagHelper.ToSlug(Model.Zone) : null;
    var gpxUrl = Url.Content($"~/media/gpx/{h.WikilocId}.gpx");
    // Le foto delle altre volte vengono dopo quelle di questa
    var galleryMedia = h.Media
        .OrderBy(m => m.Tipo == "cover" ? 0 : 1)
        .ThenBy(m => m.Ordine)
        .Concat(Model.Volte.Where(v => v.Hike != h).SelectMany(v => v.Hike.Media.OrderBy(m => m.Ordine)))
        .ToList();
    var partenza = Model.Partenza is { } start0
        ? (Coords: $"{start0.Lat.ToString(System.Globalization.CultureInfo.InvariantCulture)}, {start0.Lon.ToString(System.Globalization.CultureInfo.InvariantCulture)}",
           MapsUrl: $"https://www.google.com/maps?q={start0.Lat.ToString(System.Globalization.CultureInfo.InvariantCulture)},{start0.Lon.ToString(System.Globalization.CultureInfo.InvariantCulture)}")
        : default((string Coords, string MapsUrl)?);
}

@section Head {
    @if (Model.GpxValid)
    {
        <link rel="preconnect" href="https://unpkg.com" crossorigin />
        <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin />
        <link rel="preconnect" href="https://a.tile.openstreetmap.org" crossorigin />
        <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="anonymous" />
    }
}

<article class="hike-detail">
    @* 1. Intestazione: cosa è, dove, numeri chiave e azioni principali (quello che si cerca appena si entra) *@
    <header class="detail-header">
        @if (Model.Zone != null)
        {
            <a class="eyebrow" href="/escursioni/zona/@zoneSlug" title="Tutte le escursioni @Model.Zone">Escursioni @Model.Zone</a>
        }
        <h1 class="page-title">@displayTitle</h1>
        <p class="detail-place">
            @if (location != null)
            {
                <span>@location</span>
            }
            @if (h.DataEscursione.HasValue)
            {
                <span>Percorsa @(h.DataEsatta ? "il" : "a") <time datetime="@h.DataEscursione.Value.ToString(h.DataEsatta ? "yyyy-MM-dd" : "yyyy-MM")">@HikeDisplay.OutingDate(h)</time></span>
            }
            @if (h.UpdatedAt.Date > (h.DataEscursione ?? DateTime.MinValue).Date)
            {
                <span>Scheda aggiornata il <time datetime="@h.UpdatedAt.ToString("yyyy-MM-dd")">@h.UpdatedAt.ToString("dd/MM/yyyy")</time></span>
            }
        </p>
        <dl class="stat-strip">
            @if (!string.IsNullOrWhiteSpace(h.Difficolta))
            {
                <div><dt>Difficoltà</dt><dd class="badge @HikeDisplay.DifficultyClass(h.Difficolta)">@h.Difficolta</dd></div>
            }
            @if (h.DistanzaKm.HasValue)
            {
                <div><dt>Distanza</dt><dd>@h.DistanzaKm.Value.ToString("0.0") km</dd></div>
            }
            @if (h.DislivelloM.HasValue)
            {
                <div><dt>Dislivello</dt><dd>+@h.DislivelloM.Value m</dd></div>
            }
            @if (!string.IsNullOrWhiteSpace(h.TempoHHMM))
            {
                <div><dt>Tempo totale</dt><dd>@h.TempoHHMM</dd></div>
            }
            @if (h.QuotaMaxM.HasValue)
            {
                <div><dt>Quota</dt><dd>@(h.QuotaMinM.HasValue ? h.QuotaMinM.Value + "–" : "")@h.QuotaMaxM.Value m</dd></div>
            }
            @if (!string.IsNullOrWhiteSpace(h.TipoGiro))
            {
                <div><dt>Percorso</dt><dd>@h.TipoGiro</dd></div>
            }
        </dl>
        <div class="detail-actions">
            @if (Model.GpxValid)
            {
                <a href="@gpxUrl" class="btn" download title="Scarica la traccia GPX di @displayTitle">Scarica traccia GPX</a>
            }
            @if (partenza is { } startTop)
            {
                <a class="btn-secondary" href="@startTop.MapsUrl" target="_blank" rel="noopener" title="Indicazioni stradali per il punto di partenza su Google Maps">Indicazioni stradali</a>
            }
            @if (Model.GpxValid)
            {
                <a class="btn-secondary" href="#traccia">Vedi la mappa</a>
            }
        </div>
    </header>

    @* 2. Indice della pagina: salta subito alla sezione che interessa *@
    <nav class="detail-toc" aria-label="Sezioni della scheda">
        <a href="#traccia">Mappa</a>
        <a href="#descrizione">Percorso</a>
        <a href="#come-arrivare">Come arrivare</a>
        @if (!string.IsNullOrWhiteSpace(h.CennoStorico))
        {
            <a href="#cenno-storico">Storia</a>
        }
        @if (Model.Volte.Count > 0)
        {
            <a href="#volte">Le mie uscite</a>
        }
        @if (Model.RelatedHikes.Count > 0)
        {
            <a href="#vicine">Nei dintorni</a>
        }
    </nav>

    @* 3. Foto *@
    @if (galleryMedia.Count > 0)
    {
        <div class="detail-gallery">
            <div class="detail-carousel" data-carousel aria-roledescription="carosello" aria-label="Foto dell'escursione">
                <button type="button" class="detail-carousel-nav detail-carousel-nav--prev" data-carousel-prev aria-label="Immagine precedente">&lsaquo;</button>
                <div class="detail-carousel-track" data-carousel-track>
                    @for (var index = 0; index < galleryMedia.Count; index++)
                    {
                        var media = galleryMedia[index];
                        var galleryWebp = ImageHelper.GalleryPath(media.PathRelativo);
                        <div class="detail-carousel-slide @(index == 0 ? "is-active" : string.Empty)" data-carousel-slide>
                            <picture>
                                @if (galleryWebp != null)
                                {
                                    <source srcset="~/@galleryWebp" type="image/webp" />
                                }
                                <img src="~/@media.PathRelativo" alt="@(!string.IsNullOrWhiteSpace(media.Alt) ? media.Alt : index == 0 ? (location != null ? $"{displayTitle}, {location}" : displayTitle) : $"{displayTitle}: foto {index + 1} di {galleryMedia.Count}")" loading="@(index == 0 ? "eager" : "lazy")" fetchpriority="@(index == 0 ? "high" : "auto")" decoding="@(index == 0 ? "sync" : "async")" width="800" height="440" />
                            </picture>
                        </div>
                    }
                </div>
                <button type="button" class="detail-carousel-nav detail-carousel-nav--next" data-carousel-next aria-label="Immagine successiva">&rsaquo;</button>
            </div>
            @if (galleryMedia.Count > 10)
            {
                <p class="detail-carousel-count" data-carousel-count aria-live="polite">1 / @galleryMedia.Count</p>
            }
            else if (galleryMedia.Count > 1)
            {
                <div class="detail-carousel-dots" data-carousel-dots>
                    @for (var index = 0; index < galleryMedia.Count; index++)
                    {
                        <button type="button" class="detail-carousel-dot @(index == 0 ? "is-active" : string.Empty)" data-carousel-dot data-slide-index="@index" aria-label="Vai alla foto @(index + 1)"></button>
                    }
                </div>
            }
        </div>
    }

    <div class="detail-body">
        @* 4. Mappa e traccia, con i luoghi toccati subito sotto *@
        <section class="section" aria-labelledby="traccia">
            <h2 id="traccia">Mappa e traccia GPS</h2>
            @if (Model.GpxValid)
            {
                <div id="leaflet-gpx-map" class="map-box"></div>
            }
            <div class="track-downloads">
                @if (Model.GpxValid)
                {
                    <a href="@gpxUrl" class="btn" download title="Scarica la traccia GPX di @displayTitle">Scarica traccia GPX</a>
                }
                <a href="@h.Url" target="_blank" rel="noopener" title="Apri la traccia originale su Wikiloc">Traccia originale su Wikiloc ↗</a>
            </div>
            <div class="about-warning track-warning">
                <p>Traccia e dati sono quelli registrati durante la mia uscita: possono contenere errori e sentieri, meteo e segnaletica cambiano. Usali come riferimento, informati prima di partire e valuta sempre le tue capacità. <a href="/note-legali" title="Note legali e condizioni d'uso">Condizioni d'uso</a></p>
            </div>
            @if (Model.Luoghi.Count > 0)
            {
                <h3 id="sul-percorso" class="detail-subtitle">Sul percorso</h3>
                <ul class="place-chips">
                    @foreach (var p in Model.Luoghi)
                    {
                        <li>
                            <a href="@p.Url" title="@(p.Scheda?.Nome ?? p.Type.TitoloLink)">
                                <span class="place-chip-type">@p.Type.Singolare</span>
                                <span class="place-chip-name">@(p.Scheda?.Nome ?? p.Nome)</span>
                                @if (p.QuotaM is int q)
                                {
                                    <span class="place-chip-quota">@HikeDisplay.Meters(q)</span>
                                }
                            </a>
                        </li>
                    }
                </ul>
            }
        </section>

        @* 5. Il racconto del percorso *@
        <section class="section" aria-labelledby="descrizione">
            <h2 id="descrizione">Descrizione del percorso</h2>
            <div class="prose">
                @if (!string.IsNullOrWhiteSpace(h.DescrizioneHtml))
                {
                    @* Strip first <h2> from generated HTML to avoid duplicate with page H1 *@
                    var htmlContent = System.Text.RegularExpressions.Regex.Replace(
                        h.DescrizioneHtml, @"<h2[^>]*>.*?</h2>", "", System.Text.RegularExpressions.RegexOptions.IgnoreCase, TimeSpan.FromSeconds(1));
                    @Html.Raw(htmlContent)
                }
                else if (!string.IsNullOrWhiteSpace(h.Descrizione))
                {
                    <p>@h.Descrizione</p>
                }
                else
                {
                    <p>Nessuna descrizione dettagliata disponibile.</p>
                }
            </div>
        </section>

        @* 6. Logistica *@
        <section class="section" aria-labelledby="come-arrivare">
            <h2 id="come-arrivare">Come arrivare e parcheggio</h2>
            @if (!string.IsNullOrWhiteSpace(h.ComeArrivare))
            {
                <div class="prose">@Html.Raw(h.ComeArrivare)</div>
            }
            @if (partenza is { } start)
            {
                <div class="start-box">
                    <p class="start-box-coords">Punto di partenza: <strong>@start.Coords</strong></p>
                    <a id="parking-google-maps-link" class="btn-secondary" href="@start.MapsUrl" target="_blank" rel="noopener" title="Apri il punto di partenza su Google Maps">Apri su Google Maps</a>
                </div>
            }
            else
            {
                <p class="panel-note">Coordinate del punto di partenza non disponibili.</p>
            }
        </section>

        @* 7. Approfondimento *@
        @if (!string.IsNullOrWhiteSpace(h.CennoStorico))
        {
            <section class="section" aria-labelledby="cenno-storico">
                <h2 id="cenno-storico">Cenno storico</h2>
                <div class="prose">
                    <p>@h.CennoStorico</p>
                </div>
                @if (h.Fonti.Count > 0)
                {
                    <p class="sources-title">Fonti</p>
                    <ul class="sources">
                        @foreach (var f in h.Fonti)
                        {
                            <li><a href="@f.Url" target="_blank" rel="noopener">@f.Titolo</a></li>
                        }
                    </ul>
                }
            </section>
        }

        @* 8. Le altre uscite *@
        @if (Model.Volte.Count > 0)
        {
            <section class="section" aria-labelledby="volte">
                <h2 id="volte">Le volte che l'ho fatta</h2>
                @if (Model.Uscite > 1)
                {
                    <p class="section-intro">L'ho percorsa @Model.Uscite volte, con qualche variante: tutte le tracce sono sulla mappa qui sopra.</p>
                }
                else
                {
                    <p class="section-intro">L'ho registrata in @Model.Volte.Count tracce: le trovi tutte sulla mappa qui sopra.</p>
                }
                <div class="table-scroll">
                    <table class="times-table">
                        <thead>
                            <tr><th scope="col">Data</th><th scope="col">Distanza</th><th scope="col">Dislivello</th><th scope="col">Percorso</th><th scope="col">Tempo</th><th scope="col">Traccia</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var v in Model.Volte)
                            {
                                <tr class="@(v.Hike == h ? "is-current" : null)">
                                    <td>
                                        @if (v.Colore != null)
                                        {
                                            <span class="track-swatch" style="background:@v.Colore" aria-hidden="true"></span>
                                        }
                                        @if (v.Hike.DataEscursione is DateTime d)
                                        {
                                            <time datetime="@d.ToString(v.Hike.DataEsatta ? "yyyy-MM-dd" : "yyyy-MM")">@HikeDisplay.OutingDate(v.Hike)</time>
                                        }
                                        @if (v.Etichetta != null)
                                        {
                                            <span class="times-label">@v.Etichetta</span>
                                        }
                                    </td>
                                    <td>@(v.Hike.DistanzaKm is decimal km ? HikeDisplay.Decimal1(km) + " km" : "-")</td>
                                    <td>@(v.Hike.DislivelloM is int gain ? "+" + HikeDisplay.Meters(gain) : "-")</td>
                                    <td>@(v.Hike.TipoGiro ?? "-")</td>
                                    <td>@(v.Hike.TempoHHMM ?? "-")</td>
                                    <td>
                                        @if (v.GpxUrl != null)
                                        {
                                            <a href="@v.GpxUrl" download title="Scarica la traccia GPX del @HikeDisplay.OutingDate(v.Hike)">GPX</a>
                                        }
                                        <a href="@v.Hike.Url" target="_blank" rel="noopener" title="Apri questa traccia su Wikiloc">Wikiloc</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }

        @* 9. Per continuare: guide, zona, condivisione *@
        <div class="detail-more">
            @if (Model.Guide.Count > 0)
            {
                <section class="panel" aria-labelledby="guide-escursione">
                    <h2 id="guide-escursione">Nelle mie guide</h2>
                    <ul class="route-places">
                        @foreach (var g in Model.Guide)
                        {
                            <li><a href="@g.Url" title="@g.TitoloSeo">@g.Titolo</a></li>
                        }
                    </ul>
                </section>
            }
            @if (Model.Zone != null)
            {
                <section class="panel" aria-labelledby="zona-escursione">
                    <h2 id="zona-escursione">Zona: @Model.Zone</h2>
                    <p class="panel-note">@TagHelper.GetDescription(Model.Zone)</p>
                    <p class="panel-note">
                        <a class="btn-secondary" href="/escursioni/zona/@zoneSlug" title="Tutte le escursioni nella zona @Model.Zone">Tutte le escursioni @Model.Zone</a>
                    </p>
                </section>
            }
            <section class="panel" aria-labelledby="condividi">
                <h2 id="condividi">Condividi</h2>
                @{
                    var canonicalUrl = ViewData["CanonicalUrl"] as string ?? $"https://escursionilucabigoni.it/escursioni/{h.Slug}";
                    var shareTextRaw = displayTitle + " - Escursioni Luca Bigoni";
                    var shareTextEncoded = System.Net.WebUtility.UrlEncode(shareTextRaw);
                    var shareUrlEncoded = System.Net.WebUtility.UrlEncode(canonicalUrl);
                }
                <div class="share-buttons">
                    <a href="https://www.facebook.com/sharer/sharer.php?u=@shareUrlEncoded" target="_blank" rel="noopener noreferrer" class="share-btn" title="Condividi su Facebook">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
                        <span>Facebook</span>
                    </a>
                    <a href="https://wa.me/?text=@System.Net.WebUtility.UrlEncode(shareTextRaw + " " + canonicalUrl)" target="_blank" rel="noopener noreferrer" class="share-btn" title="Condividi su WhatsApp">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                        <span>WhatsApp</span>
                    </a>
                    <a href="https://t.me/share/url?url=@shareUrlEncoded&text=@shareTextEncoded" target="_blank" rel="noopener noreferrer" class="share-btn" title="Condividi su Telegram">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M11.944 0A12 12 0 000 12a12 12 0 0012 12 12 12 0 0012-12A12 12 0 0012 0h-.056zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 01.171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.230.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.479.33-.913.492-1.302.48-.428-.013-1.252-.242-1.865-.44-.751-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
                        <span>Telegram</span>
                    </a>
                    <a href="https://twitter.com/intent/tweet?text=@shareTextEncoded&url=@shareUrlEncoded" target="_blank" rel="noopener noreferrer" class="share-btn" title="Condividi su X">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z"/></svg>
                        <span>X</span>
                    </a>
                    <button type="button" class="share-btn share-btn--copy" title="Copia link" data-copy-url="@canonicalUrl">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>
                        <span>Copia link</span>
                    </button>
                </div>
            </section>
        </div>
    </div>

    @if (Model.Precedente != null || Model.Successiva != null)
    {
        <nav class="hike-pager" aria-label="Altre escursioni nella zona @Model.Zone">
            @if (Model.Precedente != null)
            {
                <a class="hike-pager-prev" href="/escursioni/@Model.Precedente.Slug" rel="prev">
                    <span>‹ Precedente in @Model.Zone</span>
                    <strong>@HikeDisplay.Title(Model.Precedente)</strong>
                </a>
            }
            @if (Model.Successiva != null)
            {
                <a class="hike-pager-next" href="/escursioni/@Model.Successiva.Slug" rel="next">
                    <span>Successiva in @Model.Zone ›</span>
                    <strong>@HikeDisplay.Title(Model.Successiva)</strong>
                </a>
            }
        </nav>
    }
</article>

@if (Model.RelatedHikes.Count > 0)
{
    <section aria-labelledby="vicine">
        <div class="section-head">
            <h2 id="vicine">Escursioni nei dintorni</h2>
            @if (Model.Zone != null)
            {
                <a class="section-link" href="/escursioni/zona/@zoneSlug" title="Tutte le escursioni @Model.Zone">Tutte le escursioni @Model.Zone →</a>
            }
        </div>
        <div class="card-grid">
            @foreach (var r in Model.RelatedHikes)
            {
                <partial name="_HikeCard" model="r" />
            }
        </div>
    </section>
}

<partial name="_GpxAvviso" />

@section Scripts {
    @if (Model.GpxValid)
    {
        <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin="anonymous"></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet-gpx/1.7.0/gpx.min.js" integrity="sha512-BsUtn1Ar2O78Q8YkY1f2pkioHOs8H43KUlP3PHus8lyAMODNq1CmemnU435dFk/SU37OGG+ooxvmEhAcNTEBFQ==" crossorigin="anonymous"></script>
        <script>
            window.gpxMapConfig = {
                gpxUrl: '@gpxUrl', elementId: 'leaflet-gpx-map',
                // Altre volte in cui ho fatto l'escursione: tracce colorate sotto quella principale
                extraTracks: [@Html.Raw(string.Join(", ", Model.Volte
                    .Where(v => v.Hike != h && v.GpxUrl != null)
                    .Select(v => $"{{ url: '{v.GpxUrl}', color: '{v.Colore}' }}")))]
            };
        </script>
        <script src="~/js/gpx-leaflet.js" asp-append-version="true" defer></script>
    }
    <script src="~/js/carousel.js" asp-append-version="true" defer></script>
    <script src="~/js/gpx-avviso.js" asp-append-version="true" defer></script>
    <script>
        document.querySelectorAll('[data-copy-url]').forEach(function (b) {
            b.addEventListener('click', function () {
                navigator.clipboard.writeText(b.getAttribute('data-copy-url')).then(function () {
                    var label = b.querySelector('span');
                    label.textContent = 'Copiato!';
                    setTimeout(function () { label.textContent = 'Copia link'; }, 2000);
                });
            });
        });
    </script>
}
