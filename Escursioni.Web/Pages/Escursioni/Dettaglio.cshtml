@page "/escursioni/{slug}"
@model Escursioni.Web.Pages.Escursioni.DettaglioModel
@using System.Globalization
@using System.Linq

@if (Model.Hike is null)
{
    <p>Escursione non trovata.</p>
}
else
{
    var h = Model.Hike;
    var displayTitle = !string.IsNullOrWhiteSpace(h.TitoloSeo) ? h.TitoloSeo : h.Titolo;
    var galleryMedia = h.Media
        .OrderBy(m => m.Tipo == "cover" ? 0 : 1)
        .ThenBy(m => m.Ordine)
        .ToList();

    <article>
        <header class="section">
            <h1 class="page-title">@displayTitle</h1>
            <p class="page-subtitle">
                @if (!string.IsNullOrWhiteSpace(h.Comune))
                {
                    @($"{h.Comune}, {h.Provincia}")
                }
                else if (!string.IsNullOrWhiteSpace(h.Regione))
                {
                    @h.Regione
                }
                @if (h.DataEscursione.HasValue)
                {
                    <span> · @h.DataEscursione.Value.ToString("dd/MM/yyyy")</span>
                }
            </p>
        </header>
        <section class="section">
            <h2 style="font-size:1.05rem;margin-bottom:0.4rem;">Traccia su OpenStreetMap Ordina per
</h2>
            @if (Model.GpxValid)
            {
                var gpxUrl = Url.Content($"~/media/gpx/{h.WikilocId}.gpx");
                <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="anonymous" />
                <div id="leaflet-gpx-map" style="width:100%;height:400px;margin-bottom:1rem;"></div>
                <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin="anonymous"></script>
                <script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet-gpx/1.7.0/gpx.min.js" crossorigin="anonymous"></script>
                <script src="/js/gpx-leaflet.js" defer></script>
                <script>
                    window.gpxMapConfig = { gpxUrl: '@gpxUrl', elementId: 'leaflet-gpx-map' };
                </script>
                <div class="track-downloads" style="margin-top:0.5rem;">
                    <a href="@gpxUrl" class="btn-secondary" download title="Scarica traccia GPX">Scarica GPX</a>
                </div>
            }
            <p style="margin-top:0.5rem;font-size:0.85rem;">
                Traccia originale:
                <a href="@h.Url" target="_blank" rel="noopener" title="Apri traccia su Wikiloc">apri su Wikiloc</a>
            </p>
        </section>

        <section class="detail-layout">
            <div>
                @if (galleryMedia.Count > 0)
                {
                    <div class="detail-gallery section">
                        <div class="detail-carousel" data-carousel>
                            <button type="button" class="detail-carousel-nav detail-carousel-nav--prev" data-carousel-prev aria-label="Immagine precedente">&lsaquo;</button>
                            <div class="detail-carousel-track" data-carousel-track>
                                @for (var index = 0; index < galleryMedia.Count; index++)
                                {
                                    var media = galleryMedia[index];
                                    var galleryWebp = ImageHelper.GalleryPath(media.PathRelativo);
                                    <div class="detail-carousel-slide @(index == 0 ? "is-active" : string.Empty)" data-carousel-slide>
                                        <picture>
                                            @if (galleryWebp != null)
                                            {
                                                <source srcset="~/@galleryWebp" type="image/webp" />
                                            }
                                            <img src="~/@media.PathRelativo" alt="@displayTitle" loading="@(index == 0 ? "eager" : "lazy")" decoding="async" width="800" height="440" />
                                        </picture>
                                    </div>
                                }
                            </div>
                            <button type="button" class="detail-carousel-nav detail-carousel-nav--next" data-carousel-next aria-label="Immagine successiva">&rsaquo;</button>
                        </div>
                        @if (galleryMedia.Count > 1)
                        {
                            <div class="detail-carousel-dots" data-carousel-dots>
                                @for (var index = 0; index < galleryMedia.Count; index++)
                                {
                                    <button type="button" class="detail-carousel-dot @(index == 0 ? "is-active" : string.Empty)" data-carousel-dot data-slide-index="@index" aria-label="Vai alla foto @(index + 1)"></button>
                                }
                            </div>
                        }
                    </div>
                }

                <section class="section">
                    <h2 style="font-size:1.1rem;margin-bottom:0.4rem;">Descrizione</h2>
                    @if (!string.IsNullOrWhiteSpace(h.DescrizioneHtml))
                    {
                        @* Strip first <h2> from generated HTML to avoid duplicate with page H1 *@
                        var htmlContent = System.Text.RegularExpressions.Regex.Replace(
                            h.DescrizioneHtml, @"<h2[^>]*>.*?</h2>", "", System.Text.RegularExpressions.RegexOptions.IgnoreCase, TimeSpan.FromSeconds(1));
                        @Html.Raw(htmlContent)
                    }
                    else if (!string.IsNullOrWhiteSpace(h.Descrizione))
                    {
                        <p>@h.Descrizione</p>
                    }
                    else
                    {
                        <p>Nessuna descrizione dettagliata disponibile.</p>
                    }
                </section>

                @if (h.Tags.Count > 0)
                {
                    <section class="section">
                        <h2 style="font-size:1.05rem;margin-bottom:0.3rem;">Tag</h2>
                        <div style="display:flex;flex-wrap:wrap;gap:0.35rem;">
                            @foreach (var t in h.Tags)
                            {
                                <span class="badge">@t.Tag</span>
                            }
                        </div>
                    </section>
                }

                <section class="section share-section">
                    <h2 style="font-size:1.05rem;margin-bottom:0.5rem;">Condividi questa escursione</h2>
                    @{
                        var canonicalUrl = ViewData["CanonicalUrl"] as string ?? $"https://escursionilucabigoni.it/escursioni/{Escursioni.Web.Pages.Escursioni.IndexModel.MakeSlug(h.Titolo)}";
                        var shareTextRaw = displayTitle + " - Escursioni Luca Bigoni";
                        var shareText = shareTextRaw; // testo non codificato per i link che lo vogliono in chiaro
                        var shareTextEncoded = System.Net.WebUtility.UrlEncode(shareTextRaw); // per Telegram/X
                        var shareUrlEncoded = System.Net.WebUtility.UrlEncode(canonicalUrl);
                    }
                    <div class="share-buttons">
                                <a href="https://www.facebook.com/sharer/sharer.php?u=@canonicalUrl"
                                    target="_blank" rel="noopener noreferrer"
                                    class="share-btn share-btn--facebook"
                                    title="Condividi su Facebook">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
                            <span>Facebook</span>
                        </a>
                                <a href="https://wa.me/?text=@System.Net.WebUtility.UrlEncode(shareText + " " + canonicalUrl)"
                                    target="_blank" rel="noopener noreferrer"
                                    class="share-btn share-btn--whatsapp"
                                    title="Condividi su WhatsApp">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                            <span>WhatsApp</span>
                        </a>
                                <a href="https://t.me/share/url?url=@canonicalUrl&text=@shareTextEncoded"
                                    target="_blank" rel="noopener noreferrer"
                                    class="share-btn share-btn--telegram"
                                    title="Condividi su Telegram">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M11.944 0A12 12 0 000 12a12 12 0 0012 12 12 12 0 0012-12A12 12 0 0012 0h-.056zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 01.171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.479.33-.913.492-1.302.48-.428-.013-1.252-.242-1.865-.44-.751-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
                            <span>Telegram</span>
                        </a>
                                <a href="https://twitter.com/intent/tweet?text=@shareTextEncoded&url=@canonicalUrl"
                                    target="_blank" rel="noopener noreferrer"
                                    class="share-btn share-btn--x"
                                    title="Condividi su X">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z"/></svg>
                            <span>X</span>
                        </a>
                        <button type="button" class="share-btn share-btn--copy" title="Copia link" onclick="navigator.clipboard.writeText('@canonicalUrl').then(function(){var b=document.querySelector('.share-btn--copy span');b.textContent='Copiato!';setTimeout(function(){b.textContent='Copia link'},2000)})">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>
                            <span>Copia link</span>
                        </button>
                    </div>
                </section>
            </div>

            <aside>
                <section class="section" itemscope itemtype="https://schema.org/SportsActivityLocation">
                    <h2 id="dati-tecnici" style="font-size:1.05rem;margin-bottom:0.4rem;">Dati tecnici</h2>
                    <div class="detail-meta">
                        <div class="detail-meta-item">
                            <strong>Distanza</strong><br />
                            @(h.DistanzaKm.HasValue? h.DistanzaKm.Value.ToString("0.0") + " km" : "-")
                        </div>
                        <div class="detail-meta-item">
                            <strong>Dislivello</strong><br />
                            @(h.DislivelloM.HasValue ? "+" + h.DislivelloM.Value + " m" : "-")
                        </div>
                        <div class="detail-meta-item">
                            <strong>Quota min</strong><br />
                            @(h.QuotaMinM.HasValue? h.QuotaMinM.Value + " m" : "-")
                        </div>
                        <div class="detail-meta-item">
                            <strong>Quota max</strong><br />
                            @(h.QuotaMaxM.HasValue? h.QuotaMaxM.Value + " m" : "-")
                        </div>
                        <div class="detail-meta-item">
                            <strong>Tempo totale</strong><br />
                            @(h.TempoHHMM ?? "-")
                        </div>
                        <div class="detail-meta-item">
                            <strong>Difficoltà</strong><br />
                            @(string.IsNullOrWhiteSpace(h.Difficolta) ? "-" : h.Difficolta)
                        </div>
                        <div class="detail-meta-item">
                            <strong>Tipo di percorso</strong><br />
                            @(string.IsNullOrWhiteSpace(h.TipoGiro) ? "-" : h.TipoGiro)
                        </div>
                        <div class="detail-meta-item">
                            <strong>Attività</strong><br />
                            @(string.IsNullOrWhiteSpace(h.Attivita) ? "-" : h.Attivita)
                        </div>
                    </div>
                </section>

                <section class="section">
                    <h2 style="font-size:1.05rem;margin-bottom:0.4rem;">Parcheggio / Partenza</h2>
                    @if (Model.GpxValid)
                    {
                        var gpxUrl = Url.Content($"~/media/gpx/{h.WikilocId}.gpx");
                        <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="anonymous" />
                        <div id="leaflet-parking-map" style="width:100%;height:250px;margin-bottom:0.5rem;"></div>
                        <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin="anonymous"></script>
                        <script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet-gpx/1.7.0/gpx.min.js" crossorigin="anonymous"></script>
                        <script src="/js/parking-leaflet.js" defer></script>
                        <script>
                            window.parkingMapConfig = {
                                gpxUrl: '@gpxUrl',
                                elementId: 'leaflet-parking-map',
                                linkElementId: 'parking-google-maps-link'
                            };
                        </script>
                        <p style="font-size:0.9rem;color:#9ca3af;">La posizione del parcheggio/partenza è la prima coordinata della traccia GPX.</p>
                        <p style="margin-top:0.4rem;">
                            <a id="parking-google-maps-link" class="btn-secondary" href="#" target="_blank" rel="noopener" style="display:none;" title="Apri parcheggio su Google Maps">Apri parcheggio su Google Maps</a>
                        </p>
                    }
                    else
                    {
                        <p>Coordinate non disponibili.</p>
                    }
                </section>

                @if (Model.RelatedHikes.Count > 0)
                {
                    <section class="section related-sidebar">
                        <h2 style="font-size:1.05rem;margin-bottom:0.8rem;">Escursioni nella stessa zona</h2>
                        <div class="card-grid">
                            @foreach (var r in Model.RelatedHikes)
                            {
                                var rCover = Escursioni.Web.Pages.Escursioni.DettaglioModel.CoverPath(r);
                                var rThumb = ImageHelper.ThumbPath(rCover);
                                var rTitle = !string.IsNullOrWhiteSpace(r.TitoloSeo) ? r.TitoloSeo : r.Titolo;
                                <article class="hike-card">
                                    @if (!string.IsNullOrWhiteSpace(rCover))
                                    {
                                        <a asp-page="/Escursioni/Dettaglio"
                                           asp-route-slug="@Escursioni.Web.Pages.Escursioni.IndexModel.MakeSlug(r.Titolo)"
                                           title="@rTitle">
                                            <picture>
                                                @if (rThumb != null)
                                                {
                                                    <source srcset="~/@rThumb" type="image/webp" />
                                                }
                                                <img src="~/@rCover" alt="@(!string.IsNullOrWhiteSpace(r.TitoloSeo) ? r.TitoloSeo : r.Titolo)" loading="lazy" decoding="async" width="400" height="160" />
                                            </picture>
                                        </a>
                                    }
                                    <div class="hike-card-body">
                                        <h3 class="hike-card-title">
                                            <a asp-page="/Escursioni/Dettaglio"
                                               asp-route-slug="@Escursioni.Web.Pages.Escursioni.IndexModel.MakeSlug(r.Titolo)"
                                               title="@rTitle">
                                                @rTitle
                                            </a>
                                        </h3>
                                        <div class="hike-card-meta">
                                            @if (!string.IsNullOrWhiteSpace(r.Comune))
                                            {
                                                @($"{r.Comune}, {r.Provincia}")
                                            }
                                        </div>
                                    </div>
                                    <div class="hike-card-footer">
                                        <span>
                                            @if (r.DistanzaKm.HasValue)
                                            {
                                                <span>@r.DistanzaKm.Value.ToString("0.0") km</span>
                                            }
                                            @if (r.DislivelloM.HasValue)
                                            {
                                                <span> · +@r.DislivelloM.Value m</span>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(r.Difficolta))
                                            {
                                                <span> · @r.Difficolta</span>
                                            }
                                        </span>
                                    </div>
                                </article>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(Model.Hike!.Tag))
                        {
                            <div style="text-align:center;margin-top:1.2rem;">
                                <a href="/escursioni/zona/@TagHelper.ToSlug(Model.Hike.Tag)"
                                   class="btn"
                                   title="Tutte le escursioni nella zona @Model.Hike.Tag">
                                    Vedi tutte le escursioni della zona @Model.Hike.Tag
                                </a>
                            </div>
                        }
                    </section>
                }
            </aside>
        </section>
    </article>

    <script src="/js/carousel.js" defer></script>
}