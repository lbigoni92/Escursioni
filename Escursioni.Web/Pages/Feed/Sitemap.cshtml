@page "/sitemap.xml"
@using Escursioni.Web.Services
@using Escursioni.Web.Pages.Escursioni
@model Escursioni.Web.Pages.Feed.SitemapModel
@{
    Layout = null;
    Response.ContentType = "application/xml; charset=utf-8";
    Response.Headers["Cache-Control"] = "public, max-age=3600, s-maxage=86400";
    var baseUrl = Model.BaseUrl;
}<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:image="http://www.google.com/schemas/sitemap-image/1.1">
    <url>
        <loc>@baseUrl/</loc>
        <changefreq>daily</changefreq>
        <priority>1.0</priority>
    </url>
    <url>
        <loc>@baseUrl/mappa</loc>
        <changefreq>weekly</changefreq>
        <priority>0.7</priority>
    </url>
    @foreach (var type in Model.PlaceTypes)
    {
    <url>
        <loc>@baseUrl/@type.Slug</loc>
        <changefreq>monthly</changefreq>
        <priority>0.6</priority>
    </url>
    }
    @foreach (var place in Model.PlacePages)
    {
    <url>
        <loc>@baseUrl@place.Url</loc>
        <changefreq>monthly</changefreq>
        <priority>0.7</priority>
    </url>
    }
    <url>
        <loc>@baseUrl/chi-sono</loc>
        <changefreq>monthly</changefreq>
        <priority>0.4</priority>
    </url>
    <url>
        <loc>@baseUrl/contatti</loc>
        <changefreq>monthly</changefreq>
        <priority>0.4</priority>
    </url>
    <url>
        <loc>@baseUrl/escursioni</loc>
        <changefreq>weekly</changefreq>
        <priority>0.7</priority>
    </url>
    @foreach (var tagSlug in Model.ActiveTagSlugs)
    {
    <url>
        <loc>@baseUrl/escursioni/zona/@tagSlug</loc>
        <changefreq>weekly</changefreq>
        <priority>0.7</priority>
    </url>
    }
    @foreach (var h in Model.Hikes)
    {
        var slug = h.Slug;
        var lastmod = h.UpdatedAt.ToString("yyyy-MM-dd");
        var cover = (h.Media.FirstOrDefault(m => m.Tipo == "cover") ?? h.Media.OrderBy(m => m.Ordine).FirstOrDefault())?.PathRelativo;
    <url>
        <loc>@baseUrl/escursioni/@slug</loc>
        <lastmod>@lastmod</lastmod>
        <changefreq>monthly</changefreq>
        <priority>0.8</priority>
        @if (!string.IsNullOrWhiteSpace(cover))
        {
        <image:image>
            <image:loc>@baseUrl/@cover</image:loc>
            <image:title>@h.Titolo</image:title>
        </image:image>
        }
    </url>
    }
</urlset>
