@page "/note-legali"
@inject IConfiguration Configuration
@{
    var _baseUrl = (Configuration["Site:BaseUrl"] ?? "https://escursionilucabigoni.it").TrimEnd('/');
    var _email = Configuration["Site:ContactEmail"] ?? "luca.bigoni@live.it";
    ViewData["Title"] = "Note legali e condizioni d'uso | Escursioni Luca Bigoni";
    ViewData["MetaDescription"] = "Note legali e condizioni d'uso di Escursioni Luca Bigoni: responsabilità, sicurezza in montagna, uso di tracce GPS, foto e testi.";
    ViewData["CanonicalUrl"] = $"{_baseUrl}/note-legali";
