@page "/mappa"
@model Escursioni.Web.Pages.Map.IndexModel

@inject IConfiguration Configuration
@{
    var baseUrl = (Configuration["Site:BaseUrl"] ?? "https://escursionilucabigoni.it").TrimEnd('/');
}

@section Scripts {
        <script defer src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
            integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
            crossorigin=""></script>
        <script defer src="https://cdnjs.cloudflare.com/ajax/libs/leaflet-gpx/1.7.0/gpx.min.js" crossorigin="anonymous"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var map = L.map('map').setView([42.5, 12.5], 6);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 18
            }).addTo(map);

            var showVisibleTracksBtn = document.getElementById('show-visible-tracks-btn');
            var visibleTracksStatus = document.getElementById('visible-tracks-status');

            var hikes = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                Model.Escursioni.Select(h => new {
                    id = h.Id,
                    wikilocId = h.WikilocId,
                    title = h.Titolo,
                    lat = h.CentroidLat,
                    lon = h.CentroidLon
                })
            ));

            // Cache per layer GPX
            var gpxCache = {};
            var gpxLayers = {};

            function slugifyTitle(title) {
                return title.toLowerCase()
                    .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
                    .replace(/[^a-z0-9]+/g, '-').replace(/-+/g, '-').replace(/^-|-$/g, '');
            }

            function setStatus(message) {
                if (!visibleTracksStatus) return;
                visibleTracksStatus.textContent = message;
            }

            function addGpxTrack(h, options) {
                options = options || {};
                var fitOnLoad = options.fitOnLoad === true;

                return new Promise(function (resolve) {
                    if (!h.wikilocId) {
                        resolve({ status: 'missing-id', hike: h });
                        return;
                    }

                    if (gpxLayers[h.wikilocId]) {
                        resolve({ status: 'already-visible', hike: h });
                        return;
                    }

                    if (gpxCache[h.wikilocId]) {
                        gpxLayers[h.wikilocId] = gpxCache[h.wikilocId].addTo(map);
                        resolve({ status: 'from-cache', hike: h });
                        return;
                    }

                    var gpxUrl = '/media/gpx/' + h.wikilocId + '.gpx';
                    var gpxLayer = new L.GPX(gpxUrl, {
                        async: true,
                        marker_options: {
                            startIconUrl: null,
                            endIconUrl: null,
                            shadowUrl: null,
                            wptIconUrls: { '': null }
                        }
                    });

                    gpxLayer.on('loaded', function (e) {
                        if (fitOnLoad) {
                            map.fitBounds(e.target.getBounds(), { maxZoom: 13 });
                        }
                        resolve({ status: 'loaded', hike: h });
                    });

                    gpxLayer.on('error', function () {
                        if (gpxLayers[h.wikilocId] === gpxLayer) {
                            delete gpxLayers[h.wikilocId];
                        }
                        resolve({ status: 'error', hike: h });
                    });

                    gpxLayer.addTo(map);
                    gpxCache[h.wikilocId] = gpxLayer;
                    gpxLayers[h.wikilocId] = gpxLayer;
                });
            }

            hikes.forEach(function (h) {
                if (!h.lat || !h.lon) return;
                var marker = L.marker([h.lat, h.lon]).addTo(map);
                var url = '/escursioni/' + slugifyTitle(h.title);
                marker.bindPopup('<a href="' + url + '" title="' + h.title + '">' + h.title + '</a>');

                marker.on('click', function () {
                    // Se layer già presente sulla mappa, rimuovi
                    if (gpxLayers[h.wikilocId]) {
                        map.removeLayer(gpxLayers[h.wikilocId]);
                        delete gpxLayers[h.wikilocId];
                        return;
                    }

                    addGpxTrack(h, { fitOnLoad: true });
                });
            });

            if (showVisibleTracksBtn) {
                showVisibleTracksBtn.addEventListener('click', function () {
                    var bounds = map.getBounds();
                    var visibleHikes = hikes.filter(function (h) {
                        return h.lat && h.lon && h.wikilocId && bounds.contains([h.lat, h.lon]);
                    });

                    if (visibleHikes.length === 0) {
                        setStatus('Nessun marker visibile nell\'area corrente.');
                        return;
                    }

                    setStatus('Caricamento tracce visibili in corso...');

                    Promise.all(visibleHikes.map(function (h) {
                        return addGpxTrack(h, { fitOnLoad: false });
                    })).then(function (results) {
                        var loadedCount = results.filter(function (r) {
                            return r.status === 'loaded' || r.status === 'from-cache';
                        }).length;
                        var alreadyVisibleCount = results.filter(function (r) {
                            return r.status === 'already-visible';
                        }).length;
                        var errorCount = results.filter(function (r) {
                            return r.status === 'error';
                        }).length;

                        var message = 'Tracce aggiunte: ' + loadedCount;
                        if (alreadyVisibleCount > 0) {
                            message += ' | Gia visibili: ' + alreadyVisibleCount;
                        }
                        if (errorCount > 0) {
                            message += ' | Errori: ' + errorCount;
                        }

                        setStatus(message);
                    });
                });
            }
        });
    </script>
}
<link rel="stylesheet"
      href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
      integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
      crossorigin="anonymous" />


<section>

    <h1 class="page-title">Mappa escursioni in Toscana e Italia – trekking con tracce GPS</h1>

    <div class="seo-text" style="margin-bottom:1.2rem;font-size:1.08em;line-height:1.7;max-width:700px;">
        <strong>Scopri tutte le escursioni e i trekking in Toscana, Alpi Apuane, Garfagnana, Appennino Tosco-Emiliano e oltre</strong> grazie a questa mappa interattiva. Ogni punto rappresenta un percorso reale, completo di traccia GPS, foto e descrizione dettagliata. Esplora sentieri panoramici, itinerari per famiglie, trekking impegnativi e passeggiate nella natura. Clicca sui marker per accedere direttamente alla scheda dell'escursione, visualizzare il percorso sulla mappa e scaricare la traccia GPX. Ideale per chi cerca idee per il weekend, avventure outdoor o semplicemente vuole conoscere nuovi sentieri in Italia centrale e settentrionale.
    </div>

    <p class="page-subtitle">
        Ogni marker rappresenta un'escursione esportata da Wikiloc.
        Clicca sul punto per aprire il dettaglio.
    </p>

    <div style="display:flex;align-items:center;gap:0.75rem;flex-wrap:wrap;margin-bottom:0.9rem;">
        <button id="show-visible-tracks-btn" type="button" class="btn btn-secondary">
            Mostra tutte le tracce nell'area visibile
        </button>
        <span id="visible-tracks-status" style="font-size:0.95rem;color:#334155;"></span>
    </div>

    <div id="map" class="map-frame"></div>

    <section class="seo-expanded" style="margin-top:2rem;max-width:900px;">
        <h2>Escursioni in Toscana sulla mappa</h2>
        <p>
            Questa mappa raccoglie numerosi percorsi escursionistici in Toscana e oltre, fornendo tracce GPS, tempi di percorrenza stimati, dislivelli e punti di interesse. Utilizza i marker per individuare rapidamente un itinerario, oppure consulta la lista sottostante per un accesso diretto alle schede dettagliate. La mappa è pensata per chi cerca trekking giornalieri, escursioni con famiglie o percorsi più impegnativi nelle Alpi Apuane e sull'Appennino.
        </p>

        <h2>Trekking nelle Alpi Apuane e Garfagnana</h2>
        <p>
            Le Alpi Apuane offrono scenari di calcare affiorante e panorami mozzafiato; la Garfagnana è ricca di vallate e sentieri meno battuti, ideali per chi cerca tranquillità. Su questa mappa troverai numerosi percorsi consigliati per entrambe le aree, con link diretti alle tracce GPS e dettagli su difficoltà e punti di partenza.
        </p>

        <h2>Come usare la mappa escursioni</h2>
        <p>
            Per usare la mappa: zooma sull'area d'interesse, clicca su un marker per aprire la scheda dell'escursione, o usa la lista sottostante per navigare direttamente alle pagine. Le tracce GPX sono disponibili per il download dalla scheda di dettaglio; porta sempre con te una copia offline se affronti percorsi isolati.
        </p>

        <h2>Escursioni disponibili</h2>
        <ul>
            @if (Model.Escursioni != null && Model.Escursioni.Any())
            {
                foreach (var h in Model.Escursioni.Take(100))
                {
                    var title = !string.IsNullOrWhiteSpace(h.TitoloSeo) ? h.TitoloSeo : h.Titolo;
                    var slug = Escursioni.Web.Pages.Escursioni.IndexModel.MakeSlug(h.Titolo);
                    <li><a href="@($"/escursioni/{slug}")">@title</a> @if(!string.IsNullOrWhiteSpace(h.Comune)) { <span>— @h.Comune</span> }</li>
                }
            }
            else
            {
                <li>Nessuna escursione trovata.</li>
            }
        </ul>
    </section>

    @* ItemList JSON-LD for crawlers *@
    @if (ViewData["ItemListJsonLd"] != null)
    {
        <script type="application/ld+json">@Html.Raw(ViewData["ItemListJsonLd"])</script>
    }
</section>
